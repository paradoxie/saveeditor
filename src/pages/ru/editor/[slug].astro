---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import EditorApp from '../../../components/EditorApp';

export async function getStaticPaths() {
  const engines = [
    {
      slug: 'rpg-maker-mv',
      name: 'RPG Maker MV/MZ',
      fileType: '.rpgsave, .rmmzsave',
      title: 'Онлайн Редактор Сохранений RPG Maker - Бесплатно .rpgsave и .rmmzsave',
      description:
        'Бесплатный редактор сохранений RPG Maker. Редактируйте файлы .rpgsave (MV) и .rmmzsave (MZ) онлайн. Изменяйте золото, характеристики, предметы, переключатели и переменные. Без загрузки.',
      keywords:
        'rpg maker save editor, редактор сохранений rpg, rpgsave editor, редактировать .rpgsave онлайн, rpg maker mv save editor, rpg maker mz save editor, rmmzsave editor',
      features: [
        'Редактировать Золото / Деньги',
        'Изменять Характеристики (Уровень, EXP, HP, MP)',
        'Разблокировать Предметы и Оружие',
        'Редактировать Переменные и Переключатели Игры',
      ],
      instructions: [
        'Найдите файл сохранения (обычно в папке `www/save/` внутри папки игры)',
        'Загрузите файл `file1.rpgsave` выше',
        'Отредактируйте золото, характеристики и переменные',
        'Скачайте измененный файл и замените оригинал',
      ],
    },
    {
      slug: 'unity',
      name: 'Unity',
      fileType: '.xml, .plist',
      title: 'Редактор Сохранений Unity | Редактировать PlayerPrefs Онлайн',
      description:
        'Бесплатный онлайн редактор сохранений Unity. Изменяйте Unity PlayerPrefs (.xml, .plist) для игр Android, iOS и ПК. Без скачивания.',
      keywords:
        'unity save editor, редактор unity playerprefs, редактировать unity xml, unity plist editor',
      features: [
        'Редактировать Данные PlayerPrefs',
        'Изменять Настройки Игры',
        'Разблокировать Уровни и Достижения',
        'Кроссплатформенная Поддержка (Android XML, iOS Plist)',
      ],
      instructions: [
        'Найдите файл сохранения Unity (часто в `AppData` или папке игры)',
        'Загрузите файл `.xml` или `.plist`',
        'Измените значения в редакторе',
        'Скачайте и замените оригинальный файл',
      ],
    },
    {
      slug: 'renpy',
      name: "Ren'Py",
      fileType: '.save',
      title: "Онлайн Редактор Сохранений Ren'Py - Бесплатно .save Файлы",
      description:
        "Бесплатный редактор сохранений Ren'Py. Редактируйте и просматривайте файлы .save онлайн. Изменяйте переменные, флаги и прогресс истории. Работает с DDLC и визуальными новеллами.",
      keywords:
        "renpy save editor, редактор сохранений ren'py, редактор .save, изменить save файл renpy, ddlc save editor, редактор визуальных новелл",
      features: [
        "Просмотр и Редактирование Данных Ren'Py",
        'Изменять Переменные и Флаги Игры',
        'Просмотр Истории и Времени Игры',
        'Только чтение (сохранение экспериментально)',
      ],
      instructions: [
        "Найдите файлы сохранения Ren'Py (обычно в `game/saves/`)",
        'Загрузите файл `.save`',
        'Отредактируйте состояние игры и переменные',
        '⚠️ Примечание: Сохранение экспериментально и может повредить файлы. Используйте на свой страх и риск.',
      ],
    },
    {
      slug: 'unreal',
      name: 'Unreal Engine',
      fileType: '.sav',
      title: 'Редактор Сохранений Unreal Engine - .sav Бесплатно | Palworld',
      description:
        'Веб-инструмент для Unreal `.sav` в стандартном формате GVAS. Поддерживает анализ, распознавание сжатия и безопасную пересборку поддерживаемых обёрток.',
      keywords:
        'unreal engine save editor, редактор palworld, редактор .sav, редактор файлов sav, gvas editor онлайн, uesave editor',
      features: [
        'Парсинг стандартного GVAS (.sav)',
        'Определение zlib/gzip/raw-deflate',
        'Автоматический режим только чтения для неподдерживаемых структур',
        'Безопасная пересборка стандартного и совместимо-обёрнутого GVAS',
      ],
      instructions: [
        'Найдите файл `.sav` в папке сохранений игры',
        'Загрузите файл в редактор',
        'Редактируйте только поддерживаемые поля при полном разборе',
        'Для сложных форматов конкретных игр используйте профильные инструменты.',
      ],
    },
    {
      slug: 'palworld',
      name: 'Palworld',
      fileType: '.sav',
      title: 'Редактор Palworld | Безопасный просмотр GVAS',
      description:
        'Специализированная точка входа для работы с Palworld `.sav`. Фокус на безопасной проверке стандартного GVAS и аккуратном редактировании.',
      keywords:
        'редактор palworld, palworld .sav, palworld gvas',
      features: [
        'Проверка формата Steam `.sav`',
        'Структурированный просмотр JSON GVAS',
        'Автоматический fallback в режим только чтения',
        'Ссылки на профильные инструменты сообщества Palworld',
      ],
      instructions: [
        'Перед редактированием сделайте backup всей папки SaveGames',
        'Загрузите файл игрока `.sav` или `Level.sav`',
        'Проверьте верхний баннер режима (редактирование / только чтение)',
        'Если формат не поддержан, используйте специализированный инструмент Palworld',
      ],
    },
    {
      slug: 'gamemaker',
      name: 'GameMaker',
      fileType: '.ini, .json',
      title: 'Редактор Сохранений GameMaker | Изменить INI и JSON',
      description:
        'Универсальный редактор для GameMaker. Модифицируйте файлы .ini и .json, используемые играми GameMaker Studio. Просто и быстро.',
      keywords:
        'gamemaker save editor, редактировать save gamemaker, undertale save editor, редактор ini gamemaker',
      features: [
        'Редактировать Конфигурационные Файлы INI',
        'Изменять Данные Сохранения JSON',
        'Fallback Текстового Редактора для Кастомных Форматов',
        'Совместимость с GameMaker Studio 1 и 2',
      ],
      instructions: [
        'Найдите файл сохранения (часто `save.ini` или `save.json`)',
        'Загрузите его в редактор',
        'Измените значения, такие как деньги, здоровье или открытые предметы',
        'Сохраните и замените оригинальный файл',
      ],
    },
    {
      slug: 'naninovel',
      name: 'NaniNovel',
      fileType: '.nson',
      title: 'Редактор Сохранений NaniNovel | Изменить Файлы .nson',
      description:
        'Редактируйте сохранения визуальных новелл NaniNovel (.nson) онлайн. Изменяйте состояние игры, флаги и переменные легко.',
      keywords: 'naninovel save editor, редактировать файл .nson, редактор визуальных новелл',
      features: [
        'Парсинг Файлов .nson',
        'Редактировать JSON Состояния Игры',
        'Изменять Глобальные Переменные',
        'Поддержка Сжатых Сохранений',
      ],
      instructions: [
        'Найдите файл сохранения `.nson`',
        'Загрузите его в редактор',
        'Измените JSON данные',
        'Скачайте обновленный файл',
      ],
    },
  ];

  return engines.map((engine) => ({
    params: { slug: engine.slug },
    props: { engine },
  }));
}

const { engine } = Astro.props;
const siteOrigin = Astro.site ? new URL(Astro.site).origin : 'https://saveeditor.top';
const absUrl = (path: string) =>
  new URL(path.endsWith('/') ? path : `${path}/`, siteOrigin).toString();
---

<BaseLayout title={engine.title} description={engine.description} keywords={engine.keywords}>
  <main class="container mx-auto px-4 py-8">
    <div class="max-w-6xl mx-auto">
      <nav class="flex text-sm text-gray-500 mb-8" aria-label="Breadcrumb">
        <ol class="inline-flex items-center space-x-1 md:space-x-3">
          <li class="inline-flex items-center">
            <a href="/ru/" class="hover:text-gray-900">Главная</a>
          </li>
          <li>
            <div class="flex items-center">
              <svg
                class="w-3 h-3 text-gray-400 mx-1"
                aria-hidden="true"
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 6 10"
              >
                <path
                  stroke="currentColor"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="m1 9 4-4-4-4"></path>
              </svg>
              <span class="ml-1 text-gray-700 font-medium">{engine.name}</span>
            </div>
          </li>
        </ol>
      </nav>

      <div class="text-center mb-10">
        <h1 class="text-3xl font-bold text-gray-900 sm:text-4xl mb-4">
          Редактор {engine.name}
        </h1>
        <p class="text-lg text-gray-600">
          Загрузите файл <code class="bg-gray-100 px-2 py-1 rounded text-sm">{engine.fileType}</code
          > чтобы начать редактирование.
        </p>
      </div>

      <!-- Interactive Editor App -->
      <div class="min-h-[400px]">
        <EditorApp client:only="react" acceptedFileTypes={engine.fileType} editorSlug={engine.slug} />
      </div>

      <div class="mt-16 prose prose-blue max-w-none">
        <h2>Как использовать</h2>
        <ol>
          {
            engine.instructions.map((step) => (
              <li>
                <Fragment set:html={step.replace(/`([^`]+)`/g, '<code>$1</code>')} />
              </li>
            ))
          }
        </ol>

        <h2>Возможности</h2>
        <ul>
          {engine.features.map((feature) => <li>{feature}</li>)}
        </ul>
      </div>

      <div class="bg-blue-50 border border-blue-100 rounded-xl p-6 mt-12 not-prose">
        <h3 class="text-lg font-bold text-blue-900 mb-2">Нужна помощь?</h3>
        <p class="text-blue-700 mb-4">
          Посмотрите наше подробное руководство для {engine.name}. (Гайды пока на английском)
        </p>
        {
          (() => {
            const tutorialMap = {
              'rpg-maker-mv': '/blog/how-to-edit-rpg-maker-save',
              unity: '/blog/how-to-edit-unity-saves',
              unreal: '/blog/how-to-edit-unreal-engine-saves',
              palworld: '/blog/palworld-save-editing-guide',
              renpy: '/blog/renpy-save-editing-guide',
              naninovel: '/blog/naninovel-save-editing-guide',
              gamemaker: '/blog/gamemaker-save-editing-guide',
            } as const;
            const tutorialLink =
              tutorialMap[engine.slug as keyof typeof tutorialMap] ||
              '/blog/common-save-file-extensions-explained';

            return (
              <a
                href={tutorialLink}
                class="text-blue-600 font-medium hover:underline flex items-center gap-1"
              >
                Читать полное руководство
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M17 8l4 4m0 0l-4 4m4-4H3"
                  />
                </svg>
              </a>
            );
          })()
        }
      </div>
    </div>
  </main>

  <!-- Schema.org Structured Data -->
  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'SoftwareApplication',
      name: `${engine.name} Save Editor`,
      description: engine.description,
      applicationCategory: 'GameApplication',
      operatingSystem: 'Web Browser',
      offers: {
        '@type': 'Offer',
        price: '0',
        priceCurrency: 'USD',
      },
      featureList: engine.features,
      url: absUrl(`/ru/editor/${engine.slug}`),
      author: {
        '@type': 'Organization',
        name: 'Save Editor Online',
        url: absUrl('/ru/'),
      },
    })}
  />

  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Home',
          item: absUrl('/ru/'),
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: `${engine.name} Editor`,
          item: absUrl(`/ru/editor/${engine.slug}`),
        },
      ],
    })}
  />
</BaseLayout>
