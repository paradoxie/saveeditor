---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import FAQ from '../FAQ.astro';
import { ui, defaultLang } from '../../i18n/ui';
import { useTranslations } from '../../i18n/utils';
import { getSiteOrigin } from '../../lib/site';
import { games } from '../../data/games';
import { editors } from '../../data/editors';
import { SMART_UPLOAD_ACCEPT } from '../../lib/saveExtensions';
import homeScriptUrl from '../../scripts/home.ts?url';

interface Props {
  lang?: keyof typeof ui;
  title: string;
  description: string;
  keywords: string;
}

const { lang = 'en', title, description, keywords } = Astro.props;
const t = useTranslations(lang);
const siteUrl = getSiteOrigin(Astro.site);
const defaultOgImage = `${siteUrl}/images/blog/rpg-maker-cover.webp`;
const homeUrl = lang === 'en' ? `${siteUrl}/` : `${siteUrl}/${lang}/`;

// Helper to handle localized links
const getPath = (path: string) => {
  if (path.startsWith('http')) return path;
  // If path is root '/', handle carefully
  const cleanPath = path.startsWith('/') ? path.slice(1) : path;
  if (lang === defaultLang) {
    return cleanPath ? `/${cleanPath}/` : '/';
  }
  return cleanPath ? `/${lang}/${cleanPath}/` : `/${lang}/`;
};

const blogPosts = (await getCollection('blog'))
  .filter((post) => {
    if (lang === 'en') return !post.slug.includes('/');
    return post.slug.startsWith(`${lang}/`);
  })
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 4); // Limit to 4 posts

const compatibleFormatCount = new Set(
  editors.flatMap((editor) => editor.fileType.split(',').map((item) => item.trim()).filter(Boolean))
).size;
const gamePageCount = games.length;
const supportedEngineCount = new Set(
  editors.filter((editor) => editor.slug !== 'generic').map((editor) => editor.slug)
).size;
---

<BaseLayout title={title} description={description} keywords={keywords}>
  <!-- Hero Section with Gradient Background -->
  <section
    class="relative overflow-hidden bg-gradient-to-br from-slate-900 via-primary-900 to-slate-900 text-white"
  >
    <!-- Decorative Elements -->
    <div class="absolute inset-0 overflow-hidden">
      <div class="absolute -top-40 -right-40 w-80 h-80 bg-primary-500/20 rounded-full blur-3xl">
      </div>
      <div class="absolute -bottom-40 -left-40 w-180 h-180 bg-blue-500/20 rounded-full blur-3xl">
      </div>
      <div
        class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-gradient-radial from-primary-600/10 to-transparent rounded-full"
      >
      </div>
    </div>

    <div class="relative container mx-auto px-4 py-20 lg:py-28">
      <div class="max-w-5xl mx-auto text-center">
        <div
          class="inline-flex items-center gap-2 px-4 py-2 bg-white/10 backdrop-blur-sm rounded-full text-sm font-medium mb-8 border border-white/20"
        >
          <span class="w-2 h-2 bg-green-400 rounded-full animate-pulse"></span>
          {t('hero.badge')}
        </div>

        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight mb-6">
          {t('hero.title.prefix')}
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-primary-400 to-cyan-400"
            >{t('hero.title.highlight')}</span
          >{t('hero.title.suffix')}
        </h1>
        <p class="text-lg sm:text-xl text-gray-300 mb-12 max-w-2xl mx-auto">
          <span set:html={t('hero.subtitle')} />
        </p>

        <!-- Smart Upload Zone -->
        <div class="max-w-2xl mx-auto mb-12">
          <div
            id="smart-upload-zone"
            class="relative group cursor-pointer border-2 border-dashed border-white/30 hover:border-primary-400 rounded-2xl p-8 lg:p-12 transition-all duration-300 hover:bg-white/5 backdrop-blur-sm"
          >
            <input
              type="file"
              id="smart-file-input"
              class="absolute inset-0 w-full h-full opacity-0 cursor-pointer z-10"
              accept={SMART_UPLOAD_ACCEPT}
            />
            <div class="text-center">
              <div
                class="w-16 h-16 bg-gradient-to-br from-primary-500 to-cyan-500 rounded-2xl flex items-center justify-center mx-auto mb-4 group-hover:scale-110 transition-transform shadow-lg shadow-primary-500/30"
              >
                <svg
                  class="w-8 h-8 text-white"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"
                  ></path>
                </svg>
              </div>
              <p class="text-xl font-semibold mb-2">{t('upload.drop')}</p>
              <p class="text-gray-400 text-sm">
                {t('upload.browse')}
              </p>
              <div class="flex flex-wrap justify-center gap-2 mt-4">
                <span class="px-2 py-1 bg-white/10 rounded text-xs">.rpgsave</span>
                <span class="px-2 py-1 bg-white/10 rounded text-xs">.rmmzsave</span>
                <span class="px-2 py-1 bg-white/10 rounded text-xs">.sav</span>
                <span class="px-2 py-1 bg-white/10 rounded text-xs">.save</span>
                <span class="px-2 py-1 bg-white/10 rounded text-xs">.xml</span>
                <span class="px-2 py-1 bg-white/10 rounded text-xs">.json</span>
                <span class="px-2 py-1 bg-white/10 rounded text-xs">.nson</span>
                <span class="px-2 py-1 bg-white/10 rounded text-xs">.zip</span>
                <span class="px-2 py-1 bg-white/10 rounded text-xs">.b64</span>
                <span class="px-2 py-1 bg-white/10 rounded text-xs">.sqlite</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Or Choose Engine -->
        <p class="text-gray-400 text-sm mb-6">{t('upload.orChoose')}</p>
        <div class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-8 gap-3 max-w-6xl mx-auto">
          <a
            href={getPath('editor/rpg-maker-mv')}
            class="group p-4 bg-white/5 hover:bg-white/10 border border-white/10 hover:border-primary-400/50 rounded-xl transition-all text-center backdrop-blur-sm"
          >
            <div class="font-semibold text-sm group-hover:text-primary-400 transition-colors">
              RPG Maker
            </div>
            <div class="text-xs text-gray-500 mt-1">.rpgsave</div>
          </a>
          <a
            href={getPath('editor/unity')}
            class="group p-4 bg-white/5 hover:bg-white/10 border border-white/10 hover:border-primary-400/50 rounded-xl transition-all text-center backdrop-blur-sm"
          >
            <div class="font-semibold text-sm group-hover:text-primary-400 transition-colors">
              Unity
            </div>
            <div class="text-xs text-gray-500 mt-1">.xml, .plist</div>
          </a>
          <a
            href={getPath('editor/renpy')}
            class="group p-4 bg-white/5 hover:bg-white/10 border border-white/10 hover:border-primary-400/50 rounded-xl transition-all text-center backdrop-blur-sm"
          >
            <div class="font-semibold text-sm group-hover:text-primary-400 transition-colors">
              Ren'Py
            </div>
            <div class="text-xs text-gray-500 mt-1">.save</div>
          </a>
          <a
            href={getPath('editor/unreal')}
            class="group p-4 bg-white/5 hover:bg-white/10 border border-white/10 hover:border-primary-400/50 rounded-xl transition-all text-center backdrop-blur-sm"
          >
            <div class="font-semibold text-sm group-hover:text-primary-400 transition-colors">
              Unreal
            </div>
            <div class="text-xs text-gray-500 mt-1">.sav</div>
          </a>
          <a
            href={getPath('editor/palworld')}
            class="group p-4 bg-white/5 hover:bg-white/10 border border-white/10 hover:border-primary-400/50 rounded-xl transition-all text-center backdrop-blur-sm"
          >
            <div class="font-semibold text-sm group-hover:text-primary-400 transition-colors">
              Palworld
            </div>
            <div class="text-xs text-gray-500 mt-1">.sav</div>
          </a>
          <a
            href={getPath('editor/gamemaker')}
            class="group p-4 bg-white/5 hover:bg-white/10 border border-white/10 hover:border-primary-400/50 rounded-xl transition-all text-center backdrop-blur-sm"
          >
            <div class="font-semibold text-sm group-hover:text-primary-400 transition-colors">
              GameMaker
            </div>
            <div class="text-xs text-gray-500 mt-1">.ini, .json</div>
          </a>
          <a
            href={getPath('editor/naninovel')}
            class="group p-4 bg-white/5 hover:bg-white/10 border border-white/10 hover:border-primary-400/50 rounded-xl transition-all text-center backdrop-blur-sm"
          >
            <div class="font-semibold text-sm group-hover:text-primary-400 transition-colors">
              NaniNovel
            </div>
            <div class="text-xs text-gray-500 mt-1">.nson</div>
          </a>
          <a
            href={getPath('editor/generic')}
            class="group p-4 bg-white/5 hover:bg-white/10 border border-white/10 hover:border-primary-400/50 rounded-xl transition-all text-center backdrop-blur-sm"
          >
            <div class="font-semibold text-sm group-hover:text-primary-400 transition-colors">
              Generic
            </div>
            <div class="text-xs text-gray-500 mt-1">inspect</div>
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="flex-grow container mx-auto px-4 py-16">
    <div class="max-w-6xl mx-auto">
      <!-- Social Proof Stats -->
      <div class="mb-16 grid grid-cols-2 lg:grid-cols-5 gap-4 sm:gap-5">
        <div class="text-center p-5 sm:p-6 bg-gradient-to-br from-primary-50 to-primary-100 rounded-2xl">
          <div class="text-3xl sm:text-4xl font-bold text-primary-600 counter" data-target={compatibleFormatCount} data-suffix="+">
            {compatibleFormatCount}+
          </div>
          <div class="text-xs sm:text-sm text-primary-700 font-medium mt-1">
            {t('stats.compatibleFormats')}
          </div>
        </div>
        <div class="text-center p-5 sm:p-6 bg-gradient-to-br from-green-50 to-green-100 rounded-2xl">
          <div class="text-3xl sm:text-4xl font-bold text-green-600 counter" data-target={supportedEngineCount} data-suffix="+">{supportedEngineCount}+</div>
          <div class="text-xs sm:text-sm text-green-700 font-medium mt-1">
            {t('stats.supportedEngines')}
          </div>
        </div>
        <div class="text-center p-5 sm:p-6 bg-gradient-to-br from-sky-50 to-sky-100 rounded-2xl">
          <div class="text-3xl sm:text-4xl font-bold text-sky-600 counter" data-target={gamePageCount} data-suffix="+">
            {gamePageCount}+
          </div>
          <div class="text-xs sm:text-sm text-sky-700 font-medium mt-1">
            {t('stats.gamePages')}
          </div>
        </div>
        <div class="text-center p-5 sm:p-6 bg-gradient-to-br from-purple-50 to-purple-100 rounded-2xl">
          <div class="text-3xl sm:text-4xl font-bold text-purple-600">
            Browser
          </div>
          <div class="text-xs sm:text-sm text-purple-700 font-medium mt-1">
            {t('stats.localProcessing')}
          </div>
        </div>
        <div class="text-center p-5 sm:p-6 bg-gradient-to-br from-amber-50 to-amber-100 rounded-2xl">
          <div class="text-3xl sm:text-4xl font-bold text-amber-600">50MB</div>
          <div class="text-xs sm:text-sm text-amber-700 font-medium mt-1">
            {t('stats.fileSizeLimit')}
          </div>
        </div>
      </div>

      <!-- How it Works -->
      <div class="mb-20">
        <h2 class="text-3xl font-bold text-center mb-4 text-gray-900">{t('how.title')}</h2>
        <p class="text-center text-gray-600 mb-12 max-w-xl mx-auto">
          {t('how.subtitle')}
        </p>
        <div class="relative grid grid-cols-1 md:grid-cols-3 gap-8 text-center">
          <!-- Connecting Lines (Desktop only) -->
          <div
            class="hidden md:block absolute top-12 left-1/4 right-1/4 h-0.5 bg-gradient-to-r from-blue-200 via-blue-300 to-blue-200"
          >
          </div>

          <div
            class="step-card p-6 bg-white rounded-xl shadow-sm border border-gray-100 relative z-10 hover:shadow-lg hover:border-primary-200 transition-all duration-300 hover:-translate-y-1"
          >
            <div
              class="step-number w-16 h-16 bg-gradient-to-br from-blue-500 to-blue-600 text-white rounded-full flex items-center justify-center mx-auto mb-6 text-2xl font-bold shadow-lg"
            >
              1
            </div>
            <h3 class="text-xl font-bold mb-3 text-gray-900">{t('how.step1.title')}</h3>
            <p class="text-gray-600">
              {t('how.step1.desc')}
            </p>
            <div class="mt-4 text-primary-600 text-sm font-medium">{t('how.step1.note')}</div>
          </div>
          <div
            class="step-card p-6 bg-white rounded-xl shadow-sm border border-gray-100 relative z-10 hover:shadow-lg hover:border-primary-200 transition-all duration-300 hover:-translate-y-1"
          >
            <div
              class="step-number w-16 h-16 bg-gradient-to-br from-blue-500 to-blue-600 text-white rounded-full flex items-center justify-center mx-auto mb-6 text-2xl font-bold shadow-lg"
            >
              2
            </div>
            <h3 class="text-xl font-bold mb-3 text-gray-900">{t('how.step2.title')}</h3>
            <p class="text-gray-600">
              {t('how.step2.desc')}
            </p>
            <div class="mt-4 text-primary-600 text-sm font-medium">{t('how.step2.note')}</div>
          </div>
          <div
            class="step-card p-6 bg-white rounded-xl shadow-sm border border-gray-100 relative z-10 hover:shadow-lg hover:border-primary-200 transition-all duration-300 hover:-translate-y-1"
          >
            <div
              class="step-number w-16 h-16 bg-gradient-to-br from-blue-500 to-blue-600 text-white rounded-full flex items-center justify-center mx-auto mb-6 text-2xl font-bold shadow-lg"
            >
              3
            </div>
            <h3 class="text-xl font-bold mb-3 text-gray-900">{t('how.step3.title')}</h3>
            <p class="text-gray-600">
              {t('how.step3.desc')}
            </p>
            <div class="mt-4 text-primary-600 text-sm font-medium">{t('how.step3.note')}</div>
          </div>
        </div>
      </div>

      <!-- Benefits -->
      <div class="mb-20 bg-gray-900 text-white rounded-2xl p-12 text-center">
        <h2 class="text-3xl font-bold mb-12">{t('benefits.title')}</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <div>
            <div
              class="w-12 h-12 bg-white/10 rounded-xl flex items-center justify-center mx-auto mb-4 text-2xl"
            >
              <svg
                class="w-6 h-6 text-primary-400 opacity-80"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"
                ></path>
              </svg>
            </div>
            <h3 class="text-xl font-bold mb-2">{t('benefits.secure.title')}</h3>
            <p class="text-gray-400">
              {t('benefits.secure.desc')}
            </p>
          </div>
          <div>
            <div
              class="w-12 h-12 bg-white/10 rounded-xl flex items-center justify-center mx-auto mb-4 text-2xl"
            >
              <svg
                class="w-6 h-6 text-amber-400 opacity-80"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M13 10V3L4 14h7v7l9-11h-7z"></path>
              </svg>
            </div>
            <h3 class="text-xl font-bold mb-2">{t('benefits.universal.title')}</h3>
            <p class="text-gray-400">
              {t('benefits.universal.desc')}
            </p>
          </div>
          <div>
            <div
              class="w-12 h-12 bg-white/10 rounded-xl flex items-center justify-center mx-auto mb-4 text-2xl"
            >
              <svg
                class="w-6 h-6 text-green-400 opacity-80"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                ></path>
              </svg>
            </div>
            <h3 class="text-xl font-bold mb-2">{t('benefits.free.title')}</h3>
            <p class="text-gray-400">
              {t('benefits.free.desc')}
            </p>
          </div>
        </div>
      </div>

      <div class="mt-24">
        <div class="text-center mb-12">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">{t('games.title')}</h2>
          <p class="text-gray-600 max-w-2xl mx-auto">
            {t('games.desc')}
          </p>
        </div>

        {/* Engine Cards */}
        <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-8 gap-4 mb-16">
          <a
            href={getPath('editor/rpg-maker-mv')}
            class="bg-white p-5 rounded-2xl shadow-sm border border-gray-100 hover:border-blue-300 hover:shadow-md transition-all group text-center"
          >
            <div
              class="w-12 h-12 bg-blue-50 text-blue-600 rounded-xl flex items-center justify-center mx-auto mb-3 group-hover:scale-110 transition-transform text-2xl"
            >
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M6 18L18 6M6 6l12 12"></path>
              </svg>
            </div>
            <h3 class="font-bold text-gray-900 text-sm">RPG Maker</h3>
            <p class="text-xs text-gray-400 mt-1">.rpgsave</p>
          </a>

          <a
            href={getPath('editor/unity')}
            class="bg-white p-5 rounded-2xl shadow-sm border border-gray-100 hover:border-gray-400 hover:shadow-md transition-all group text-center"
          >
            <div
              class="w-12 h-12 bg-gray-100 text-gray-700 rounded-xl flex items-center justify-center mx-auto mb-3 group-hover:scale-110 transition-transform text-2xl"
            >
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path>
              </svg>
            </div>
            <h3 class="font-bold text-gray-900 text-sm">Unity</h3>
            <p class="text-xs text-gray-400 mt-1">PlayerPrefs</p>
          </a>

          <a
            href={getPath('editor/renpy')}
            class="bg-white p-5 rounded-2xl shadow-sm border border-gray-100 hover:border-pink-300 hover:shadow-md transition-all group text-center"
          >
            <div
              class="w-12 h-12 bg-pink-50 text-pink-500 rounded-xl flex items-center justify-center mx-auto mb-3 group-hover:scale-110 transition-transform text-2xl"
            >
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"
                ></path>
              </svg>
            </div>
            <h3 class="font-bold text-gray-900 text-sm">Ren'Py</h3>
            <p class="text-xs text-gray-400 mt-1">.save</p>
          </a>

          <a
            href={getPath('editor/unreal')}
            class="bg-white p-5 rounded-2xl shadow-sm border border-gray-100 hover:border-slate-400 hover:shadow-md transition-all group text-center"
          >
            <div
              class="w-12 h-12 bg-slate-100 text-slate-700 rounded-xl flex items-center justify-center mx-auto mb-3 group-hover:scale-110 transition-transform text-2xl"
            >
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"
                ></path>
              </svg>
            </div>
            <h3 class="font-bold text-gray-900 text-sm">Unreal</h3>
            <p class="text-xs text-gray-400 mt-1">.sav</p>
          </a>
          <a
            href={getPath('editor/palworld')}
            class="bg-white p-5 rounded-2xl shadow-sm border border-gray-100 hover:border-cyan-300 hover:shadow-md transition-all group text-center"
          >
            <div
              class="w-12 h-12 bg-cyan-50 text-cyan-700 rounded-xl flex items-center justify-center mx-auto mb-3 group-hover:scale-110 transition-transform text-2xl"
            >
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M12 6v6l4 2M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                ></path>
              </svg>
            </div>
            <h3 class="font-bold text-gray-900 text-sm">Palworld</h3>
            <p class="text-xs text-gray-400 mt-1">GVAS</p>
          </a>

          <a
            href={getPath('editor/gamemaker')}
            class="bg-white p-5 rounded-2xl shadow-sm border border-gray-100 hover:border-green-300 hover:shadow-md transition-all group text-center"
          >
            <div
              class="w-12 h-12 bg-green-50 text-green-600 rounded-xl flex items-center justify-center mx-auto mb-3 group-hover:scale-110 transition-transform text-2xl"
            >
