---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { games as baseGames } from '../../../data/games';

export async function getStaticPaths() {
  const overrides: Record<string, any> = {
    'stardew-valley': {
      name: 'Stardew Valley',
      nameLocal: '스타듀 밸리',
      seoDescription:
        '스타듀 밸리(Stardew Valley) 무료 온라인 세이브 에디터 (다운로드 없음). 골드, 아이템, 스킬 레벨을 즉시 편집하세요. PC, Mac, 모바일 지원. 안전한 로컬 처리.',
      seoContent: `
        <h2>스타듀 밸리 세이브 에디터를 선택해야 하는 이유</h2>
        <p>이 자동화 도구는 스타듀 밸리의 복잡한 XML 구조를 분석하여 세이브 파일을 쉽고 안전하게 편집할 수 있게 해줍니다. 파일 손상 위험이 있는 수동 편집과 달리, 데이터 무결성을 검증합니다.</p>
        <h3>주요 기능</h3>
        <ul>
            <li><strong>무제한 자원:</strong> 골드, 치 젬, 카지노 코인을 즉시 추가하세요.</li>
            <li><strong>인벤토리 관리:</strong> 배낭이나 상자에 원하는 아이템(무지개 파편, 갤럭시 소드 등)을 추가하세요.</li>
            <li><strong>스킬 만렙:</strong> 농사, 채광, 채집, 낚시, 전투 스킬을 즉시 10 레벨로 올리세요.</li>
            <li><strong>호감도 조절:</strong> 주민이나 결혼 대상과의 하트를 최대로 만드세요.</li>
        </ul>
        <h3>안전한 로컬 처리</h3>
        <p>호환되는 형식은 브라우저에서 처리되며, 구조를 신뢰성 있게 다시 만들 수 없으면 읽기 전용으로 전환될 수 있습니다. 자세한 내용은 개인정보/쿠키 정책을 확인하세요.</p>
      `,
      description: 'ConcernedApe의 인기 농장 시뮬레이션 RPG.',
      editableItems: [
        { icon: '💰', name: '골드', desc: '농장 수입 편집' },
        { icon: '🎒', name: '아이템', desc: '모든 아이템 추가' },
        { icon: '❤️', name: '호감도', desc: '주민과의 우정 변경' },
        { icon: '📈', name: '스킬', desc: '농업, 채광 등 레벨업' },
        { icon: '🏆', name: '업적', desc: '커뮤니티 센터 해제' },
        { icon: '🗓️', name: '날짜', desc: '현재 계절과 날짜 변경' },
      ],
      faq: [
        {
          question: '스타듀 밸리 세이브 파일은 어디에 있나요?',
          answer:
            'Windows에서는 %appdata%\\StardewValley\\Saves에 있습니다. 각 세이브 폴더는 농부 이름(예: FarmerName_123456789)으로 지정됩니다.',
        },
        {
          question: '멀티플레이어 세이브도 편집할 수 있나요?',
          answer:
            '네, 호스트로서 자신의 세이브만 편집할 수 있습니다. 공유 농장 데이터를 손상시키지 않도록 주의하세요.',
        },
      ],
      relatedGuides: [
        { title: 'Unity 세이브 편집 가이드', url: '/ko/blog/how-to-edit-unity-saves' },
      ],
    },
    'palworld': {
      name: 'Palworld',
      nameLocal: '팰월드',
      seoDescription:
        'Palworld `.sav` 전용 온라인 워크플로우. 표준 GVAS를 우선 지원하며, 안전한 조회와 호환 파일의 신중한 편집에 초점을 둡니다. 비호환 포맷은 자동 읽기 전용 처리됩니다.',
      seoContent: `
        <h2>팰월드 세이브 편집 (호환성 우선)</h2>
        <p>이 워크플로우는 <strong>안전한 조회를 우선</strong>합니다. 표준 GVAS는 편집 가능할 수 있지만, 게임별 컨테이너/암호화 포맷은 읽기 전용으로 전환됩니다.</p>
        <h3>호환 세이브에서 조정 가능한 항목(예시)</h3>
        <ul>
            <li><strong>플레이어:</strong> 레벨 및 일부 진행 수치(실제 파싱 구조 기준).</li>
            <li><strong>팰:</strong> 노출된 파라미터 확인 및 백업 기반의 보수적 수정.</li>
            <li><strong>인벤토리/기지:</strong> 구조를 확인하며 작은 단위로 변경 후 즉시 검증.</li>
        </ul>
        <h3>Steam vs Game Pass</h3>
        <p>Steam 저장은 표준 플로우에 들어갈 가능성이 높고, Game Pass/Xbox 저장은 추가 컨테이너로 인해 읽기 전용이 되는 경우가 많습니다.</p>
      `,
      description: 'Pocketpair가 개발한 생존형 몬스터 수집 게임.',
      editableItems: [
        { icon: '💰', name: '골드', desc: '호환 세이브에서 화폐 필드 확인/조정' },
        { icon: '🦎', name: '팰 데이터', desc: '팰 구조를 검토하고 지원 시에만 신중히 수정' },
        { icon: '📈', name: '플레이어 스탯', desc: '지원 변형에서 레벨/체력 등 조정' },
        { icon: '🎒', name: '인벤토리', desc: '아이템 배열을 확인하고 단계적으로 수정' },
        { icon: '🏠', name: '기지 진행도', desc: 'GVAS에 노출된 기지 관련 데이터 확인' },
      ],
      faq: [
        {
          question: 'Palworld 세이브 파일은 어디에 있나요?',
          answer:
            'Windows: %localappdata%\\Pal\\Saved\\SaveGames. 일반적으로 각 월드 폴더에 Level.sav(월드)와 Players 폴더(플레이어)가 있습니다.',
        },
        {
          question: 'Steam Deck에서도 편집 가능한가요?',
          answer:
            '가능합니다. Proton prefix 경로에서 파일을 가져와 편집 후 다시 넣을 수 있습니다.',
        },
        {
          question: '왜 읽기 전용으로 뜨나요?',
          answer:
            '게임 전용 컨테이너/암호화 포맷일 가능성이 높습니다. 브라우저에서 안전한 재패키징이 어려워 읽기 전용으로 제한됩니다.',
        },
        {
          question: '안전하게 편집하려면 어떻게 해야 하나요?',
          answer:
            '매번 SaveGames 폴더 전체를 백업하고, 한 번에 한 항목씩 변경한 뒤 즉시 게임에서 확인하세요.',
        },
      ],
      relatedGuides: [
        { title: 'Palworld 세이브 편집 가이드', url: '/ko/blog/palworld-save-editing-guide' },
        { title: 'Unreal Engine 세이브 편집 가이드', url: '/ko/blog/how-to-edit-unreal-engine-saves' },
      ],
    },
    'undertale': {
      name: 'Undertale',
      nameLocal: '언더테일',
      seoDescription:
        '언더테일(Undertale) 무료 온라인 세이브 에디터. file0 및 undertale.ini 파일 편집. HP, 골드, EXP, FUN 값, 불살/몰살 루트 플래그 변경.',
      seoContent: `
        <h2>언더테일 세이브 파일 에디터 (file0 & undertale.ini)</h2>
        <p>언더테일은 주로 두 개의 파일로 데이터를 관리합니다: <code>file0</code> (현재 세이브 슬롯)과 <code>undertale.ini</code> (메타 데이터 및 영구 플래그). 이 에디터로 두 파일을 모두 수정할 수 있습니다.</p>
        <h3>주요 수정 가능 항목</h3>
        <ul>
            <li><strong>몰살/불살 루트 변경:</strong> 게임을 다시 시작하지 않고도 특정 루트 플래그를 리셋하거나 트리거하여 스토리 진행을 바꿀 수 있습니다.</li>
            <li><strong>FUN 값:</strong> <code>undertale.ini</code>의 'fun' 변수를 수정하여 가스터 추종자와 같은 무작위 이벤트를 발생시킵니다.</li>
            <li><strong>전투 능력치:</strong> HP, ATK, DEF, EXP를 수정하여 전투 난이도를 조절하세요.</li>
        </ul>
        <h3>사용 방법</h3>
        <p>현재 능력치를 수정하려면 <code>file0</code>을 업로드하세요. '메타' 이벤트를 변경하거나 진정한 불살 엔딩(True Pacifist) 체크를 리셋하려면 <code>undertale.ini</code> 파일을 편집하세요.</p>
      `,
      description: 'Toby Fox의 명작 인디 RPG. 아무도 죽지 않아도 되는 세계.',
      editableItems: [
        { icon: '❤️', name: 'HP & LV', desc: '체력과 LOVE 레벨 변경' },
        { icon: '🎒', name: '인벤토리', desc: '아이템 편집' },
        { icon: '💰', name: '골드 (G)', desc: '소지금 변경' },
        { icon: '📍', name: '세이브 위치', desc: '저장 지점 변경' },
        { icon: '🎮', name: '게임 플래그', desc: '스토리 진행 조작' },
      ],
      faq: [
        {
          question: 'Undertale 세이브는 어디에 있나요?',
          answer:
            'Windows: %localappdata%\\UNDERTALE. Mac: ~/Library/Application Support/com.tobyfox.undertale/. 메인 파일은 file0(세이브 데이터)과 undertale.ini(설정)입니다.',
        },
      ],
      relatedGuides: [
        { title: 'GameMaker 세이브 편집 가이드', url: '/ko/blog/gamemaker-save-editing-guide' },
      ],
    },
    'ddlc': {
      name: 'Doki Doki Literature Club',
      nameLocal: '도키도키 문예부',
      description: 'Team Salvato의 심리 호러 비주얼 노벨.',
      editableItems: [
        { icon: '📖', name: '스토리 진행', desc: '원하는 챕터로 이동' },
        { icon: '❤️', name: '캐릭터 호감도', desc: '캐릭터와의 관계 변경' },
        { icon: '🖼️', name: 'CG 갤러리', desc: '모든 이미지 해제' },
      ],
      faq: [
        {
          question: 'DDLC 세이브는 어디에 있나요?',
          answer:
            'Windows: %appdata%\\RenPy\\DDLC-1454445547. DDLC Plus는 %appdata%\\..\\LocalLow\\Team Salvato\\Doki Doki Literature Club Plus에 있습니다.',
        },
      ],
      relatedGuides: [
        { title: "Ren'Py 세이브 편집 가이드", url: '/ko/blog/renpy-save-editing-guide' },
      ],
    },
    'hollow-knight': {
      name: 'Hollow Knight',
      nameLocal: '할로우 나이트',
      description: 'Team Cherry의 호평받는 메트로이드바니아.',
      editableItems: [
        { icon: '💰', name: '지오', desc: '화폐 편집' },
        { icon: '❤️', name: '마스크', desc: '최대 HP 변경' },
        { icon: '💎', name: '소울', desc: '소울 미터 변경' },
        { icon: '✨', name: '부적', desc: '부적 노치와 해제 편집' },
      ],
      faq: [
        {
          question: 'Hollow Knight 세이브는 어디에 있나요?',
          answer:
            'Windows: %appdata%\\..\\LocalLow\\Team Cherry\\Hollow Knight. 파일은 각 세이브 슬롯에 user1.dat, user2.dat 등으로 명명됩니다.',
        },
      ],
      relatedGuides: [
        { title: 'Unity 세이브 편집 가이드', url: '/ko/blog/how-to-edit-unity-saves' },
      ],
    },
    'rpg-maker': {
      name: 'RPG 만들기 게임',
      nameLocal: 'RPG 만들기',
      description: 'RPG 만들기 시리즈로 만든 수천 개의 게임.',
      editableItems: [
        { icon: '💰', name: '골드', desc: '파티의 돈 편집' },
        { icon: '👥', name: '스탯', desc: 'HP, MP, 레벨, 경험치 변경' },
        { icon: '🎒', name: '인벤토리', desc: '아이템 추가/삭제' },
        { icon: '⚔️', name: '장비', desc: '무기와 방어구 변경' },
      ],
      faq: [
        {
          question: 'RPG 만들기 세이브는 어디에 있나요?',
          answer:
            '대부분의 RPG 만들기 MV/MZ 게임은 게임 디렉토리 내 www/save 또는 save 폴더에 세이브를 저장합니다.',
        },
      ],
      relatedGuides: [
        { title: 'RPG 만들기 세이브 편집 가이드', url: '/ko/blog/how-to-edit-rpg-maker-save' },
      ],
    },
  };

  return baseGames.map((baseGame) => {
    const override = overrides[baseGame.slug] || {};
    const nameLocal = override.nameLocal || override.name || baseGame.name;
    const format = baseGame.format;

    const game = {
      ...baseGame,
      nameLocal,
      seoDescription: override.seoDescription ||
        `${nameLocal}의 세이브 위치, ${format} 호환 항목, 지원 한계, 자주 발생하는 실패 이유를 먼저 확인할 수 있는 안내 페이지입니다.`,
      seoContent: override.seoContent || `
        <h2>${nameLocal} 세이브 편집 개요</h2>
        <p>이 페이지는 ${format} 저장 파일의 위치, 편집기에 자주 노출되는 항목, 알려진 제한 사항을 정리한 안내입니다. 수정 전에는 반드시 백업을 만들고, 작은 변경부터 게임 내에서 검증하세요.</p>
        <h3>먼저 확인할 내용</h3>
        <ul>
            <li><strong>세이브 경로:</strong> 올바른 파일을 선택했는지 먼저 확인하세요.</li>
            <li><strong>호환성:</strong> ${format}의 일부 변형은 조회 전용이거나 재구성이 실패할 수 있습니다.</li>
            <li><strong>검증:</strong> 한 번에 작은 값만 바꾸고 게임에서 바로 확인하세요.</li>
        </ul>
      `,
      description: override.description || `${nameLocal} 세이브 경로와 호환성 범위를 정리한 안내 페이지입니다.`,
      editorPath: baseGame.editorPath.replace('/editor/', '/ko/editor/'),
      editableItems: override.editableItems || baseGame.editableItems.map(item => ({
        icon: item.icon,
        name: item.name,
        desc: `${item.name} 필드 상세 정보 조회 및 수정`
      })),
      faq: override.faq || [
        {
          question: `${nameLocal} 세이브 파일은 어디에 저장되나요?`,
          answer: `Windows의 경우 기본 저장 경로는 다음과 같습니다: ${baseGame.saveLocations.windows}. macOS 또는 Linux는 본 페이지의 저장 위치 안내 탭을 확인하세요.`
        },
        {
          question: '이 온라인 에디터를 사용하는 것이 안전한가요?',
          answer: '호환되는 변형은 브라우저에서 처리되지만, 일부 구조는 조회 전용이거나 실패할 수 있습니다. 지원 한계를 먼저 확인하고 원본 백업을 유지하세요.'
        }
      ],
      relatedGuides: (override.relatedGuides || baseGame.relatedGuides || []).map((guide: any) => ({
        title: guide.title,
        url: guide.url.replace('/blog/', '/ko/blog/').replace('/games/', '/ko/games/')
      }))
    };

    return {
      params: { slug: baseGame.slug },
      props: { game },
    };
  });
}

const { game } = Astro.props;
const otherGames = baseGames.filter((item) => item.slug !== game.slug).slice(0, 6);
---

<BaseLayout
  title={`${game.nameLocal} 세이브 에디터 - ${game.format} 파일 무료 편집`}
  description={game.seoDescription}
  keywords={`${game.nameLocal.toLowerCase()} 세이브 에디터, ${game.nameLocal.toLowerCase()} 세이브 위치, ${game.nameLocal.toLowerCase()} 세이브 편집, ${game.format} 에디터`}
>
  <!-- Hero Section -->
  <section
    class="relative overflow-hidden bg-gradient-to-br from-slate-900 via-primary-900 to-slate-900 text-white py-16"
  >
    <div class="absolute inset-0 overflow-hidden">
      <div class="absolute -top-40 -right-40 w-80 h-80 bg-primary-500/20 rounded-full blur-3xl">
      </div>
      <div class="absolute -bottom-40 -left-40 w-80 h-80 bg-blue-500/20 rounded-full blur-3xl">
      </div>
    </div>

    <div class="relative container mx-auto px-4">
      <div class="max-w-4xl mx-auto text-center">
        <div class="text-6xl mb-6">{game.emoji}</div>
        <h1 class="text-4xl sm:text-5xl font-bold tracking-tight mb-4">
          {game.nameLocal}
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-primary-400 to-cyan-400"
            >세이브 에디터</span
          >
        </h1>
        <p class="text-xl text-gray-300 mb-8 max-w-2xl mx-auto">
          {game.description} 세이브 파일을 무료로 온라인 편집.
        </p>

        <div class="flex flex-wrap justify-center gap-4 mb-8">
          <span class="px-4 py-2 bg-white/10 rounded-full text-sm">엔진: {game.engine}</span>
          <span class="px-4 py-2 bg-white/10 rounded-full text-sm">형식: {game.format}</span>
          <span class="px-4 py-2 bg-green-500/20 text-green-300 rounded-full text-sm"
            >브라우저 워크플로우</span
          >
        </div>

        <a
          href={game.editorPath}
          class="inline-flex items-center justify-center px-8 py-4 text-lg font-semibold text-gray-900 bg-gradient-to-r from-primary-400 to-cyan-400 rounded-xl hover:opacity-90 transition-opacity shadow-lg"
        >
          {game.nameLocal} 세이브 편집하기 →
        </a>
      </div>
    </div>
  </section>

  <section class="container mx-auto px-4 py-16">
    <div class="max-w-6xl mx-auto">
      <section class="mb-16">
        <h2 class="text-3xl font-bold text-center mb-8 text-gray-900">
          {game.nameLocal}에서 편집할 수 있는 것
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {
            game.editableItems.map((item: { icon: string; name: string; desc: string }) => (
              <div class="p-6 bg-white rounded-xl shadow-sm border border-gray-100 hover:shadow-md transition-shadow">
                <div class="text-3xl mb-3">{item.icon}</div>
                <h3 class="font-bold text-gray-900 mb-2">{item.name}</h3>
                <p class="text-gray-600 text-sm">{item.desc}</p>
              </div>
            ))
          }
        </div>
      </section>

      <section class="mb-16 bg-gray-50 rounded-2xl p-8">
        <h2 class="text-2xl font-bold mb-6 text-gray-900">📂 {game.nameLocal} 세이브 파일 위치</h2>
        <div class="space-y-4">
          <div class="bg-white p-4 rounded-lg border border-gray-200">
            <span class="px-3 py-1 bg-blue-100 text-blue-700 text-sm font-medium rounded"
              >Windows</span
            >
            <code class="text-sm text-gray-600 break-all block mt-2"
              >{game.saveLocations.windows}</code
            >
          </div>
          <div class="bg-white p-4 rounded-lg border border-gray-200">
            <span class="px-3 py-1 bg-gray-100 text-gray-700 text-sm font-medium rounded"
              >macOS</span
            >
            <code class="text-sm text-gray-600 break-all block mt-2">{game.saveLocations.mac}</code>
          </div>
          <div class="bg-white p-4 rounded-lg border border-gray-200">
            <span class="px-3 py-1 bg-orange-100 text-orange-700 text-sm font-medium rounded"
              >Linux</span
            >
            <code class="text-sm text-gray-600 break-all block mt-2"
              >{game.saveLocations.linux}</code
            >
          </div>
        </div>
      </section>

      <section class="mb-16">
        <h2 class="text-3xl font-bold text-center mb-8 text-gray-900">자주 묻는 질문</h2>
        <div class="max-w-3xl mx-auto space-y-4">
          {
            game.faq.map((item: { question: string; answer: string }) => (
              <details class="group bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
                <summary class="flex items-center justify-between p-6 cursor-pointer font-semibold text-gray-900 hover:bg-gray-50">
                  {item.question}
                  <svg
                    class="w-5 h-5 text-gray-500 group-open:rotate-180 transition-transform"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M19 9l-7 7-7-7"
                    />
                  </svg>
                </summary>
                <div class="px-6 pb-6 text-gray-600">{item.answer}</div>
              </details>
            ))
          }
        </div>
      </section>

      {
        game.relatedGuides.length > 0 && (
          <section class="mb-16 bg-primary-50 rounded-2xl p-8">
            <h2 class="text-2xl font-bold mb-6 text-gray-900">📖 관련 가이드</h2>
            <div class="space-y-4">
              {game.relatedGuides.map((guide: { title: string; url: string }) => (
                <a
                  href={guide.url}
                  class="flex items-center justify-between p-4 bg-white rounded-lg border border-primary-100 hover:border-primary-300 transition-colors"
                >
                  <span class="font-medium text-gray-900">{guide.title}</span>
                  <svg
                    class="w-5 h-5 text-primary-600"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M9 5l7 7-7 7"
                    />
                  </svg>
                </a>
              ))}
            </div>
          </section>
        )
      }

      <!-- Related Games -->
      <section class="mb-16">
        <h2 class="text-2xl font-bold text-center mb-6 text-gray-900">다른 인기 게임</h2>
        <div class="grid grid-cols-2 md:grid-cols-6 gap-4">
          {
            otherGames.map((item) => (
              <a
                href={`/ko/games/${item.slug}`}
                class="p-4 bg-white rounded-xl border border-gray-100 hover:border-primary-300 hover:shadow-md transition-all text-center group"
              >
                <span class="text-2xl block mb-2">{item.emoji}</span>
                <span class="font-medium text-gray-900 group-hover:text-primary-600 text-sm">
                  {item.name}
                </span>
              </a>
            ))
          }
        </div>
        <div class="text-center mt-6">
          <a href="/ko/games" class="text-primary-600 hover:text-primary-700 font-medium">
            모든 게임 보기 →
          </a>
        </div>
      </section>

      <section class="bg-gray-900 text-white rounded-2xl p-12 text-center">
        <h2 class="text-3xl font-bold mb-4">{game.nameLocal} 세이브를 편집할 준비가 되셨나요?</h2>
        <p class="text-gray-300 mb-8">원본 파일을 교체하기 전에 호환성, 제한 사항, 세이브 경로를 먼저 확인하세요.</p>
        <a
          href={game.editorPath}
          class="inline-flex items-center justify-center px-8 py-4 text-lg font-semibold text-gray-900 bg-white rounded-xl hover:bg-gray-100 transition-colors"
        >
          지금 편집 시작 →
        </a>
      </section>
    </div>
  </section>

  {/* SEO Content Section */}
  {
    game.seoContent && (
      <section class="max-w-4xl mx-auto mt-16 prose prose-lg prose-slate px-6 py-8 bg-white rounded-2xl shadow-sm border border-gray-100">
        <Fragment set:html={game.seoContent} />
      </section>
    )
  }
</BaseLayout>

<!-- BreadcrumbList Schema -->
<script
  type="application/ld+json"
  set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: '홈', item: 'https://saveeditor.top/ko/' },
      {
        '@type': 'ListItem',
        position: 2,
        name: '게임',
        item: 'https://saveeditor.top/ko/games/',
      },
      {
        '@type': 'ListItem',
        position: 3,
        name: game.nameLocal,
        item: `https://saveeditor.top/ko/games/${game.slug}/`,
      },
    ],
  })}
/>

<script
  type="application/ld+json"
  set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: game.faq.map((item: { question: string; answer: string }) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: { '@type': 'Answer', text: item.answer },
    })),
  })}
/>
