---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FAQ from '../../components/FAQ.astro';
import { games as baseGames } from '../../data/games';
import { absoluteUrl, getSiteOrigin } from '../../lib/site';

export async function getStaticPaths() {
  return baseGames.map((game) => ({
    params: { slug: game.slug },
    props: { game },
  }));
}

const { game } = Astro.props;
const siteOrigin = getSiteOrigin(Astro.site);
const absUrl = (path: string) => absoluteUrl(path, siteOrigin);
const imageUrl = absUrl(game.image);
const featureList = (game.editorQuickEditTargets.length > 0 ? game.editorQuickEditTargets : game.quickEditTargets).slice(0, 8);
const engineTutorials: Record<string, string> = {
  'RPG Maker': '/blog/how-to-edit-rpg-maker-save',
  'Unity': '/blog/how-to-edit-unity-saves',
  'Unreal Engine': '/blog/how-to-edit-unreal-engine-saves',
  "Ren'Py": '/blog/renpy-save-editing-guide',
  'GameMaker': '/blog/gamemaker-save-editing-guide',
  'Naninovel': '/blog/naninovel-save-editing-guide'
};

const getFallbackGuides = (gameData: typeof game) => {
  if (gameData.relatedGuides && gameData.relatedGuides.length > 0) {
    return gameData.relatedGuides;
  }
  if (gameData.slug === 'palworld') {
    return [{ title: 'Palworld Save Editing Guide', url: '/blog/palworld-save-editing-guide' }];
  }
  const tutorialUrl = engineTutorials[gameData.engine];
  if (tutorialUrl) {
    return [{ title: `${gameData.name} (${gameData.engine}) Save Editing Guide`, url: tutorialUrl }];
  }
  return [];
};

const activeGuides = getFallbackGuides(game);
const otherGames = baseGames.filter((item) => item.slug !== game.slug).slice(0, 6);
---

<BaseLayout
  title={game.seoTitleByLocale.en}
  description={game.seoDescriptionByLocale.en}
  keywords={game.longTailTermsByLocale.en.join(', ')}
  ogImage={game.image}
>
  <!-- Hero Section -->
  <section class="relative bg-slate-900 text-white overflow-hidden">
    <!-- Background Image with Overlay -->
    <div class="absolute inset-0 z-0">
      <img
        src={game.image}
        alt=""
        aria-hidden="true"
        class="w-full h-full object-cover opacity-20 blur-sm"
      />
      <div
        class="absolute inset-0 bg-gradient-to-b from-slate-900/50 via-slate-900/80 to-slate-900"
      >
      </div>
    </div>

    <div class="relative z-10 container mx-auto px-4 py-20 lg:py-28">
      <div class="max-w-4xl mx-auto text-center">
        <div class="mb-8 relative inline-block group">
          <div
            class="absolute -inset-1 bg-gradient-to-r from-primary-600 to-cyan-600 rounded-2xl blur opacity-40 group-hover:opacity-75 transition duration-200"
          >
          </div>
          <img
            src={game.image}
            alt={game.imageAltByLocale.en}
            class="relative w-full max-w-lg h-auto rounded-xl shadow-2xl border border-white/10 mx-auto transform transition hover:scale-[1.02]"
          />
          <div
            class="absolute -top-6 -right-6 w-16 h-16 bg-primary-600 rounded-2xl flex items-center justify-center text-4xl shadow-lg rotate-12"
          >
            {game.emoji}
          </div>
        </div>

        <h1 class="text-5xl lg:text-7xl font-bold tracking-tight mb-6 mt-8">
          {game.name}
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-primary-400 to-cyan-400"
            >Save Editor</span
          >
        </h1>
        <p class="text-xl text-gray-300 mb-8 max-w-2xl mx-auto">
          {game.description} Edit your save files online for free.
        </p>

        <div class="flex flex-wrap justify-center gap-4 mb-8">
          <span class="px-4 py-2 bg-white/10 rounded-full text-sm">
            Engine: {game.engine}
          </span>
          <span class="px-4 py-2 bg-white/10 rounded-full text-sm">
            Format: {game.format}
          </span>
          <span class="px-4 py-2 bg-green-500/20 text-green-300 rounded-full text-sm">
            ✓ Free to Use
          </span>

        </div>

        <a
          href={`${game.editorPath}?game=${game.slug}`}
          class="inline-flex items-center justify-center px-8 py-4 text-lg font-semibold text-gray-900 bg-gradient-to-r from-primary-400 to-cyan-400 rounded-xl hover:opacity-90 transition-opacity shadow-lg"
        >
          Start Editing {game.name} Saves →
        </a>
      </div>
    </div>
  </section>

  <section class="container mx-auto px-4 py-16">
    <div class="max-w-6xl mx-auto">
      <!-- What Can You Edit Section -->
      <section class="mb-16">
        <h2 class="text-3xl font-bold text-center mb-8 text-gray-900">
          Verified In The Editor
        </h2>
        {game.editorVerifiedItems.length > 0 ? (
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {
              game.editorVerifiedItems.map((item: { icon: string; name: string; desc: string }) => (
                <div class="p-6 bg-white rounded-xl shadow-sm border border-gray-100 hover:shadow-md transition-shadow">
                  <div class="text-3xl mb-3">{item.icon}</div>
                  <h3 class="font-bold text-gray-900 mb-2">{item.name}</h3>
                  <p class="text-gray-600 text-sm">{item.desc}</p>
                </div>
              ))
            }
          </div>
        ) : (
          <p class="rounded-2xl border border-amber-100 bg-amber-50 p-5 text-sm text-amber-900">
            No game-specific verified editor fields yet. Candidate and engine-level notes stay visible below.
          </p>
        )}
        <div class="mt-6 rounded-2xl border border-indigo-100 bg-indigo-50 p-5 text-sm text-indigo-900">
          <p class="font-semibold">Evidence status: {game.presetConfidence}</p>
          <p class="mt-1 text-indigo-700">Verified editor fields come from the evidence model only. Game-specific notes stay separate below.</p>
          <a class="mt-3 inline-flex text-primary-700 hover:underline" href="/coverage-proof">View coverage proof</a>
        </div>
      </section>

      <section class="mb-16">
        <h2 class="text-3xl font-bold text-center mb-8 text-gray-900">
          Game-Specific Editing Notes For {game.name}
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {
            game.editableItems.map((item: { icon: string; name: string; desc: string }) => (
              <div class="p-6 bg-white rounded-xl shadow-sm border border-gray-100 hover:shadow-md transition-shadow">
                <div class="text-3xl mb-3">{item.icon}</div>
                <h3 class="font-bold text-gray-900 mb-2">{item.name}</h3>
                <p class="text-gray-600 text-sm">{item.desc}</p>
              </div>
            ))
          }
        </div>
      </section>

      <!-- Compatibility Expectations Section -->
      <section class="mb-16 bg-white rounded-2xl p-8 border border-gray-100 shadow-sm">
        <h2 class="text-2xl font-bold mb-6 text-gray-900">
          Compatibility & Common Failure Reasons
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
          <div class="rounded-xl border border-emerald-100 bg-emerald-50 p-4">
            <h3 class="font-semibold text-emerald-900 mb-2">Best case</h3>
            <p class="text-sm text-emerald-800">
              The file opens in Quick Edit, common fields are detected, and the download button is enabled.
            </p>
          </div>
          <div class="rounded-xl border border-amber-100 bg-amber-50 p-4">
            <h3 class="font-semibold text-amber-900 mb-2">Read-only mode</h3>
            <p class="text-sm text-amber-800">
              The file can be inspected, but export is disabled because this structure cannot be rebuilt safely in-browser.
            </p>
          </div>
          <div class="rounded-xl border border-red-100 bg-red-50 p-4">
            <h3 class="font-semibold text-red-900 mb-2">Parse error</h3>
            <p class="text-sm text-red-800">
              The file may be encrypted, compressed by a custom container, the wrong save file, or larger than the browser limit.
            </p>
          </div>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div>
            <h3 class="font-semibold text-gray-900 mb-3">Support limits</h3>
            <ul class="list-disc list-inside text-sm text-gray-700 space-y-2">
              {game.supportLimits.map((item: string) => <li>{item}</li>)}
            </ul>
          </div>
          <div>
            <h3 class="font-semibold text-gray-900 mb-3">Failure reasons</h3>
            <ul class="list-disc list-inside text-sm text-gray-700 space-y-2">
              {game.failureReasons.map((item: string) => <li>{item}</li>)}
            </ul>
          </div>
        </div>
      </section>

      <section class="mb-16 bg-indigo-50 rounded-2xl p-8 border border-indigo-100">
        <h2 class="text-2xl font-bold mb-4 text-gray-900">Quick Edit Targets</h2>
        <div class="flex flex-wrap gap-2 mb-6">
          {(game.editorQuickEditTargets.length > 0 ? game.editorQuickEditTargets : game.quickEditTargets).map((target: string) => (
            <span class="rounded-full bg-white px-3 py-1 text-sm font-medium text-indigo-800 border border-indigo-200">
              {target}
            </span>
          ))}
        </div>
        <h3 class="font-semibold text-gray-900 mb-3">Backup steps</h3>
        <ol class="list-decimal list-inside text-sm text-gray-700 space-y-2">
          {game.backupSteps.map((step: string) => <li>{step}</li>)}
        </ol>
        {game.sourceRefs.length > 0 && (
          <div class="mt-5 text-sm text-gray-600">
            Sources: {game.sourceRefs.map((ref: { title: string; url: string }, index: number) => (
              <>
                <a class="text-primary-700 hover:underline" href={ref.url} rel="nofollow noopener" target="_blank">
                  {ref.title}
                </a>{index < game.sourceRefs.length - 1 ? ', ' : ''}
              </>
            ))}
          </div>
        )}
        <a class="mt-4 inline-flex text-sm font-semibold text-primary-700 hover:underline" href="/coverage-proof">
          Evidence-backed coverage proof
        </a>
      </section>

      <!-- Save File Location Section -->
      <section class="mb-16 bg-gray-50 rounded-2xl p-8">
        <h2 class="text-2xl font-bold mb-6 text-gray-900">
          📂 {game.name} Save File Location
        </h2>
        <div class="space-y-4">
          <div class="bg-white p-4 rounded-lg border border-gray-200">
            <div class="flex items-center gap-3 mb-2">
              <span class="px-3 py-1 bg-blue-100 text-blue-700 text-sm font-medium rounded"
                >Windows</span
              >
            </div>
            <code class="text-sm text-gray-600 break-all">{game.saveLocations.windows}</code>
          </div>
          <div class="bg-white p-4 rounded-lg border border-gray-200">
            <div class="flex items-center gap-3 mb-2">
              <span class="px-3 py-1 bg-gray-100 text-gray-700 text-sm font-medium rounded"
                >macOS</span
              >
            </div>
            <code class="text-sm text-gray-600 break-all">{game.saveLocations.mac}</code>
          </div>
          <div class="bg-white p-4 rounded-lg border border-gray-200">
            <div class="flex items-center gap-3 mb-2">
              <span class="px-3 py-1 bg-orange-100 text-orange-700 text-sm font-medium rounded"
                >Linux</span
              >
            </div>
            <code class="text-sm text-gray-600 break-all">{game.saveLocations.linux}</code>
          </div>
        </div>
        <p class="text-gray-500 text-sm mt-4">
          💡 Tip: Press Win+R on Windows and paste the path to quickly access your saves.
        </p>
      </section>

      <!-- How to Edit Section -->
      <section class="mb-16">
        <h2 class="text-3xl font-bold text-center mb-8 text-gray-900">
          How to Edit {game.name} Saves
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <div class="text-center p-6">
            <div
              class="w-16 h-16 bg-gradient-to-br from-blue-500 to-blue-600 text-white rounded-full flex items-center justify-center mx-auto mb-4 text-2xl font-bold shadow-lg"
            >
              1
            </div>
            <h3 class="font-bold text-lg mb-2">Locate Your Save</h3>
            <p class="text-gray-600">
              Find your save file using the paths above. Make a backup copy first!
            </p>
          </div>
          <div class="text-center p-6">
            <div
              class="w-16 h-16 bg-gradient-to-br from-blue-500 to-blue-600 text-white rounded-full flex items-center justify-center mx-auto mb-4 text-2xl font-bold shadow-lg"
            >
              2
            </div>
            <h3 class="font-bold text-lg mb-2">Upload & Edit</h3>
            <p class="text-gray-600">
              {
                game.slug === 'palworld'
                  ? 'Upload your `.sav` and check compatibility mode first. If it is read-only, inspect safely and switch to a dedicated Palworld tool for write operations.'
                  : 'Drag your save file to our editor. Modify gold, items, stats and more.'
              }
            </p>
          </div>
          <div class="text-center p-6">
            <div
              class="w-16 h-16 bg-gradient-to-br from-blue-500 to-blue-600 text-white rounded-full flex items-center justify-center mx-auto mb-4 text-2xl font-bold shadow-lg"
            >
              3
            </div>
            <h3 class="font-bold text-lg mb-2">Download & Play</h3>
            <p class="text-gray-600">
              {
                game.slug === 'palworld'
                  ? 'Download only when the editor confirms compatible editable mode. Otherwise keep your backup and continue with a dedicated Palworld tool.'
                  : 'Download your edited save and replace the original. Launch the game!'
              }
            </p>
          </div>
        </div>
        <div class="text-center mt-8">
          <a
            href={`${game.editorPath}?game=${game.slug}`}
            class="inline-flex items-center justify-center px-8 py-4 text-lg font-semibold text-white bg-primary-600 rounded-xl hover:bg-primary-700 transition-colors"
          >
            Open {game.name} Editor
          </a>
        </div>
      </section>

      <!-- FAQ Section -->
      <section class="mb-16">
        <h2 class="text-3xl font-bold text-center mb-8 text-gray-900">
          Frequently Asked Questions
        </h2>
        <div class="max-w-3xl mx-auto space-y-4">
          {
            game.faq.map((item: { question: string; answer: string }) => (
              <details class="group bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
                <summary class="flex items-center justify-between p-6 cursor-pointer font-semibold text-gray-900 hover:bg-gray-50">
                  {item.question}
                  <svg
                    class="w-5 h-5 text-gray-500 group-open:rotate-180 transition-transform"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M19 9l-7 7-7-7"
                    />
                  </svg>
                </summary>
                <div class="px-6 pb-6 text-gray-600">{item.answer}</div>
              </details>
            ))
          }
        </div>
      </section>

      <!-- Related Guides -->
      {
        activeGuides.length > 0 && (
          <section class="mb-16 bg-primary-50 rounded-2xl p-8">
            <h2 class="text-2xl font-bold mb-6 text-gray-900">📖 Related Guides</h2>
            <div class="space-y-4">
              {activeGuides.map((guide: { title: string; url: string }) => (
                <a
                  href={guide.url}
                  class="flex items-center justify-between p-4 bg-white rounded-lg border border-primary-100 hover:border-primary-300 transition-colors"
                >
                  <span class="font-medium text-gray-900">{guide.title}</span>
                  <svg
                    class="w-5 h-5 text-primary-600"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M9 5l7 7-7 7"
                    />
                  </svg>
                </a>
              ))}
            </div>
          </section>
        )
      }

      <!-- Related Games (Cross-linking) -->
      <section class="mb-16">
        <h2 class="text-2xl font-bold text-center mb-6 text-gray-900">Other Popular Games</h2>
        <div class="grid grid-cols-2 md:grid-cols-6 gap-4">
          {
            otherGames.map((item) => (
              <a
                href={`/games/${item.slug}`}
                class="p-4 bg-white rounded-xl border border-gray-100 hover:border-primary-300 hover:shadow-md transition-all text-center group"
              >
                <span class="text-2xl block mb-2">{item.emoji}</span>
                <span class="font-medium text-gray-900 group-hover:text-primary-600 text-sm">
                  {item.name}
                </span>
              </a>
            ))
          }
        </div>
        <div class="text-center mt-6">
          <a href="/games" class="text-primary-600 hover:text-primary-700 font-medium">
            Browse All Games →
          </a>
        </div>
      </section>

      <!-- CTA Section -->
      <section class="bg-gray-900 text-white rounded-2xl p-12 text-center">
        <h2 class="text-3xl font-bold mb-4">Ready to Edit Your {game.name} Save?</h2>
        <p class="text-gray-300 mb-8 max-w-xl mx-auto">
          Free to use, no download required. Browser-side parsing with backup-first editing.
        </p>
        <a
          href={`${game.editorPath}?game=${game.slug}`}
          class="inline-flex items-center justify-center px-8 py-4 text-lg font-semibold text-gray-900 bg-white rounded-xl hover:bg-gray-100 transition-colors"
        >
          Start Editing Now →
        </a>
      </section>
    </div>

    {/* SEO Content Section */}
    {
      game.seoContent && (
        <section class="max-w-4xl mx-auto mt-16 prose prose-lg prose-slate px-6 py-8 bg-white rounded-2xl shadow-sm border border-gray-100">
          <Fragment set:html={game.seoContent} />
        </section>
      )
    }
  </section>

  <!-- SoftwareApplication Schema -->
  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Home',
          item: absUrl('/'),
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Games',
          item: absUrl('/games'),
        },
        {
          '@type': 'ListItem',
          position: 3,
          name: game.name,
          item: absUrl(`/games/${game.slug}`),
        },
      ],
    })}
  />

  <!-- FAQ Schema -->
  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: game.faq.map((item: { question: string; answer: string }) => ({
        '@type': 'Question',
        name: item.question,
        acceptedAnswer: {
          '@type': 'Answer',
          text: item.answer,
        },
      })),
    })}
  />

  <!-- SoftwareApplication Schema -->
  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'SoftwareApplication',
      name: `${game.name} Save Editor`,
      applicationCategory: 'UtilitiesApplication',
      operatingSystem: 'Web Browser',
      inLanguage: 'en',
      url: absUrl(`/games/${game.slug}`),
      image: imageUrl,
      isAccessibleForFree: true,
      featureList,
      offers: {
        '@type': 'Offer',
        price: '0',
        priceCurrency: 'USD',
      },
      description: `Free online save editor for ${game.name}. Edit ${game.format} files directly in your browser.`,
      author: {
        '@type': 'Organization',
        name: 'SaveEditor.Online',
        url: absUrl('/'),
      },
    })}
  />
</BaseLayout>
