---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import {
  games as baseGames,
  localizeGamePage,
  localizePresetConfidence,
} from '../../../data/games';
import { absoluteUrl, getSiteOrigin } from '../../../lib/site';

const locale = 'zh-cn' as const;
const localizedNames: Record<string, string> = {
  "stardew-valley": "星露谷物语",
  "palworld": "幻兽帕鲁",
  "undertale": "传说之下",
  "ddlc": "心跳文学部",
  "hollow-knight": "空洞骑士",
  "rpg-maker": "RPG Maker 游戏",
  "omori": "OMORI",
  "lisa-the-painful": "LISA: The Painful",
  "to-the-moon": "去月球",
  "mad-father": "狂父",
  "oneshot": "OneShot",
  "katawa-shoujo": "片轮少女",
  "fear-and-hunger": "Fear & Hunger",
  "ib": "Ib",
  "yume-nikki": "梦日记",
  "the-witchs-house": "魔女之家",
  "ao-oni": "青鬼",
  "mogeko-castle": "Mogeko Castle",
  "misao": "操",
  "off": "OFF",
  "wadanohara": "大海原与大海原",
  "pocket-mirror": "Pocket Mirror",
  "hello-charlotte": "Hello Charlotte",
  "teaching-feeling": "Teaching Feeling",
  "being-a-dik": "Being a DIK",
  "summertime-saga": "Summertime Saga"
};
const copy = {
  "titleSuffix": "存档编辑器",
  "descSuffix": "在线编辑存档文件，查看存档位置、可改字段、限制和失败原因。",
  "engine": "引擎",
  "format": "格式",
  "free": "免费使用",
  "start": "开始编辑",
  "verified": "编辑器已验证能力",
  "noVerified": "当前没有游戏级 verified 字段；以下为候选/引擎级能力和游戏说明。",
  "evidence": "证据状态",
  "evidenceBody": "verified 只来自证据模型；游戏说明与编辑器能力分开展示。",
  "notes": "游戏级编辑说明",
  "compatibility": "兼容性与常见失败原因",
  "best": "最佳情况",
  "bestBody": "文件进入 Quick Edit，字段可识别，并且下载按钮可用。",
  "readonly": "只读模式",
  "readonlyBody": "可查看结构，但浏览器端无法安全重建，因此禁用导出。",
  "parse": "解析失败",
  "parseBody": "文件可能被加密、压缩、选错、或超过浏览器处理限制。",
  "limits": "支持限制",
  "failures": "失败原因",
  "targets": "Quick Edit 目标",
  "backup": "备份步骤",
  "location": "存档位置",
  "tip": "提示：Windows 可按 Win+R 后粘贴路径快速打开。",
  "how": "如何编辑",
  "locate": "找到存档",
  "locateBody": "按上方路径找到存档，并先复制备份。",
  "upload": "上传并编辑",
  "uploadBody": "上传存档，在 Quick Edit 或高级模式中小步修改。",
  "download": "下载并验证",
  "downloadBody": "下载修改后的文件，替换前保留备份，并进游戏验证。",
  "open": "打开编辑器",
  "faq": "常见问题",
  "guides": "相关指南",
  "other": "其他热门游戏",
  "browse": "浏览全部游戏",
  "ready": "准备编辑存档？",
  "ctaBody": "免费使用，无需下载。浏览器本地解析，先备份再修改。",
  "now": "立即开始"
};

export async function getStaticPaths() {
  const routeNames: Record<string, string> = {
  "stardew-valley": "星露谷物语",
  "palworld": "幻兽帕鲁",
  "undertale": "传说之下",
  "ddlc": "心跳文学部",
  "hollow-knight": "空洞骑士",
  "rpg-maker": "RPG Maker 游戏",
  "omori": "OMORI",
  "lisa-the-painful": "LISA: The Painful",
  "to-the-moon": "去月球",
  "mad-father": "狂父",
  "oneshot": "OneShot",
  "katawa-shoujo": "片轮少女",
  "fear-and-hunger": "Fear & Hunger",
  "ib": "Ib",
  "yume-nikki": "梦日记",
  "the-witchs-house": "魔女之家",
  "ao-oni": "青鬼",
  "mogeko-castle": "Mogeko Castle",
  "misao": "操",
  "off": "OFF",
  "wadanohara": "大海原与大海原",
  "pocket-mirror": "Pocket Mirror",
  "hello-charlotte": "Hello Charlotte",
  "teaching-feeling": "Teaching Feeling",
  "being-a-dik": "Being a DIK",
  "summertime-saga": "Summertime Saga"
  };
  return baseGames.map((game) => {
    const localized = localizeGamePage(game, 'zh-cn', routeNames[game.slug] ?? game.name);
    return { params: { slug: game.slug }, props: { game: localized } };
  });
}

const { game } = Astro.props;
const siteOrigin = getSiteOrigin(Astro.site);
const absUrl = (path: string) => absoluteUrl(path, siteOrigin);
const editorHref = game.editorPath.replace('/editor/', '/zh-cn/editor/');
const editorHrefWithGame = `${editorHref}?game=${game.slug}`;
const gameHref = (slug: string) => `/zh-cn/games/${slug}`;
const gamesHref = '/zh-cn/games';
const coverageHref = '/zh-cn/coverage-proof';
const confidenceLabel = localizePresetConfidence(game.presetConfidence, locale);
const quickTargets = game.editorQuickEditTargets.length > 0 ? game.editorQuickEditTargets : game.quickEditTargets;
const imageUrl = absUrl(game.image);
const featureList = quickTargets.slice(0, 8);

const engineTutorialsZh: Record<string, string> = {
  'RPG Maker': '/zh-cn/blog/how-to-edit-rpg-maker-save',
  'Unity': '/zh-cn/blog/how-to-edit-unity-saves',
  'Unreal Engine': '/zh-cn/blog/how-to-edit-unreal-engine-saves',
  "Ren'Py": '/zh-cn/blog/renpy-save-editing-guide',
  'GameMaker': '/zh-cn/blog/gamemaker-save-editing-guide',
  'Naninovel': '/zh-cn/blog/naninovel-save-editing-guide'
};

const getFallbackGuidesZh = (gameData: typeof game) => {
  if (gameData.relatedGuides && gameData.relatedGuides.length > 0) {
    return gameData.relatedGuides.map(g => ({
      title: g.title,
      url: g.url.startsWith('/zh-cn') ? g.url : `/zh-cn${g.url}`
    }));
  }
  if (gameData.slug === 'palworld') {
    return [{ title: '幻兽帕鲁存档修改教程', url: '/zh-cn/blog/palworld-save-editing-guide' }];
  }
  const tutorialUrl = engineTutorialsZh[gameData.engine];
  if (tutorialUrl) {
    const name = gameData.nameLocal || gameData.name;
    return [{ title: `${name} (${gameData.engine}) 存档修改指南`, url: tutorialUrl }];
  }
  return [];
};

const activeGuidesZh = getFallbackGuidesZh(game);
---

<BaseLayout
  title={game.seoTitleByLocale[locale]}
  description={game.seoDescriptionByLocale[locale]}
  keywords={game.longTailTermsByLocale[locale].join(', ')}
  ogImage={game.image}
>
  <section class="relative bg-slate-900 text-white overflow-hidden">
    <div class="absolute inset-0 z-0">
      <img src={game.image} alt="" aria-hidden="true" class="w-full h-full object-cover opacity-20 blur-sm" />
      <div class="absolute inset-0 bg-gradient-to-b from-slate-900/50 via-slate-900/80 to-slate-900"></div>
    </div>
    <div class="relative z-10 container mx-auto px-4 py-20 lg:py-28">
      <div class="max-w-4xl mx-auto text-center">
        <div class="mb-8 relative inline-block group">
          <div class="absolute -inset-1 bg-gradient-to-r from-primary-600 to-cyan-600 rounded-2xl blur opacity-40"></div>
          <img src={game.image} alt={game.imageAltByLocale[locale]} class="relative w-full max-w-lg h-auto rounded-xl shadow-2xl border border-white/10 mx-auto" />
          <div class="absolute -top-6 -right-6 w-16 h-16 bg-primary-600 rounded-2xl flex items-center justify-center text-4xl shadow-lg rotate-12">{game.emoji}</div>
        </div>
        <h1 class="text-5xl lg:text-7xl font-bold tracking-tight mb-6 mt-8">
          {game.nameLocal} <span class="text-transparent bg-clip-text bg-gradient-to-r from-primary-400 to-cyan-400">{copy.titleSuffix}</span>
        </h1>
        <p class="text-xl text-gray-300 mb-8 max-w-2xl mx-auto">{game.description}</p>
        <div class="flex flex-wrap justify-center gap-4 mb-8">
          <span class="px-4 py-2 bg-white/10 rounded-full text-sm">{copy.engine}: {game.engine}</span>
          <span class="px-4 py-2 bg-white/10 rounded-full text-sm">{copy.format}: {game.format}</span>
          <span class="px-4 py-2 bg-green-500/20 text-green-300 rounded-full text-sm">{copy.free}</span>
        </div>
        <a href={editorHrefWithGame} class="inline-flex items-center justify-center px-8 py-4 text-lg font-semibold text-gray-900 bg-gradient-to-r from-primary-400 to-cyan-400 rounded-xl hover:opacity-90 transition-opacity shadow-lg">{copy.start}</a>
      </div>
    </div>
  </section>

  <section class="container mx-auto px-4 py-16">
    <div class="max-w-6xl mx-auto">
      <section class="mb-16">
        <h2 class="text-3xl font-bold text-center mb-8 text-gray-900">{copy.verified}</h2>
        {game.editorVerifiedItems.length > 0 ? (
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {game.editorVerifiedItems.map((item: { icon: string; name: string; desc: string }) => (
              <div class="p-6 bg-white rounded-xl shadow-sm border border-gray-100">
                <div class="text-3xl mb-3">{item.icon}</div>
                <h3 class="font-bold text-gray-900 mb-2">{item.name}</h3>
                <p class="text-gray-600 text-sm">{item.desc}</p>
              </div>
            ))}
          </div>
        ) : (
          <p class="rounded-2xl border border-amber-100 bg-amber-50 p-5 text-sm text-amber-900">{copy.noVerified}</p>
        )}
        <div class="mt-6 rounded-2xl border border-indigo-100 bg-indigo-50 p-5 text-sm text-indigo-900">
          <p class="font-semibold">{copy.evidence}: {confidenceLabel}</p>
          <p class="mt-1 text-indigo-700">{copy.evidenceBody}</p>
          <a class="mt-3 inline-flex text-primary-700 hover:underline" href={coverageHref}>查看覆盖证据</a>
        </div>
      </section>

      <section class="mb-16">
        <h2 class="text-3xl font-bold text-center mb-8 text-gray-900">{copy.notes}</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {game.editableItems.map((item: { icon: string; name: string; desc: string }) => (
            <div class="p-6 bg-white rounded-xl shadow-sm border border-gray-100">
              <div class="text-3xl mb-3">{item.icon}</div>
              <h3 class="font-bold text-gray-900 mb-2">{item.name}</h3>
              <p class="text-gray-600 text-sm">{item.desc}</p>
            </div>
          ))}
        </div>
      </section>

      <section class="mb-16 bg-white rounded-2xl p-8 border border-gray-100 shadow-sm">
        <h2 class="text-2xl font-bold mb-6 text-gray-900">{copy.compatibility}</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
          <div class="rounded-xl border border-emerald-100 bg-emerald-50 p-4"><h3 class="font-semibold text-emerald-900 mb-2">{copy.best}</h3><p class="text-sm text-emerald-800">{copy.bestBody}</p></div>
          <div class="rounded-xl border border-amber-100 bg-amber-50 p-4"><h3 class="font-semibold text-amber-900 mb-2">{copy.readonly}</h3><p class="text-sm text-amber-800">{copy.readonlyBody}</p></div>
          <div class="rounded-xl border border-red-100 bg-red-50 p-4"><h3 class="font-semibold text-red-900 mb-2">{copy.parse}</h3><p class="text-sm text-red-800">{copy.parseBody}</p></div>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div><h3 class="font-semibold text-gray-900 mb-3">{copy.limits}</h3><ul class="list-disc list-inside text-sm text-gray-700 space-y-2">{game.supportLimits.map((item: string) => <li>{item}</li>)}</ul></div>
          <div><h3 class="font-semibold text-gray-900 mb-3">{copy.failures}</h3><ul class="list-disc list-inside text-sm text-gray-700 space-y-2">{game.failureReasons.map((item: string) => <li>{item}</li>)}</ul></div>
        </div>
      </section>

      <section class="mb-16 bg-indigo-50 rounded-2xl p-8 border border-indigo-100">
        <h2 class="text-2xl font-bold mb-4 text-gray-900">{copy.targets}</h2>
        <div class="flex flex-wrap gap-2 mb-6">{quickTargets.map((target: string) => <span class="rounded-full bg-white px-3 py-1 text-sm font-medium text-indigo-800 border border-indigo-200">{target}</span>)}</div>
        <h3 class="font-semibold text-gray-900 mb-3">{copy.backup}</h3>
        <ol class="list-decimal list-inside text-sm text-gray-700 space-y-2">{game.backupSteps.map((step: string) => <li>{step}</li>)}</ol>
        {game.sourceRefs.length > 0 && (
          <div class="mt-5 text-sm text-gray-600">
            来源：{game.sourceRefs.map((ref: { title: string; url: string }, index: number) => (
              <>
                <a class="text-primary-700 hover:underline" href={ref.url} rel="nofollow noopener" target="_blank">{ref.title}</a>{index < game.sourceRefs.length - 1 ? '、' : ''}
              </>
            ))}
          </div>
        )}
        <a class="mt-4 inline-flex text-sm font-semibold text-primary-700 hover:underline" href={coverageHref}>查看证据覆盖页</a>
      </section>

      <section class="mb-16 bg-gray-50 rounded-2xl p-8">
        <h2 class="text-2xl font-bold mb-6 text-gray-900">{copy.location}</h2>
        <div class="space-y-4">
          <div class="bg-white p-4 rounded-lg border border-gray-200"><span class="px-3 py-1 bg-blue-100 text-blue-700 text-sm font-medium rounded">Windows</span><code class="mt-2 block text-sm text-gray-600 break-all">{game.saveLocations.windows}</code></div>
          <div class="bg-white p-4 rounded-lg border border-gray-200"><span class="px-3 py-1 bg-gray-100 text-gray-700 text-sm font-medium rounded">macOS</span><code class="mt-2 block text-sm text-gray-600 break-all">{game.saveLocations.mac}</code></div>
          <div class="bg-white p-4 rounded-lg border border-gray-200"><span class="px-3 py-1 bg-orange-100 text-orange-700 text-sm font-medium rounded">Linux</span><code class="mt-2 block text-sm text-gray-600 break-all">{game.saveLocations.linux}</code></div>
        </div>
        <p class="text-gray-500 text-sm mt-4">{copy.tip}</p>
      </section>

      <section class="mb-16">
        <h2 class="text-3xl font-bold text-center mb-8 text-gray-900">{copy.how}</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          {[ [copy.locate, copy.locateBody], [copy.upload, copy.uploadBody], [copy.download, copy.downloadBody] ].map(([title, body], index) => (
            <div class="text-center p-6"><div class="w-16 h-16 bg-gradient-to-br from-blue-500 to-blue-600 text-white rounded-full flex items-center justify-center mx-auto mb-4 text-2xl font-bold shadow-lg">{index + 1}</div><h3 class="font-bold text-lg mb-2">{title}</h3><p class="text-gray-600">{body}</p></div>
          ))}
        </div>
        <div class="text-center mt-8"><a href={editorHrefWithGame} class="inline-flex items-center justify-center px-8 py-4 text-lg font-semibold text-white bg-primary-600 rounded-xl hover:bg-primary-700">{copy.open}</a></div>
      </section>

      <section class="mb-16">
        <h2 class="text-3xl font-bold text-center mb-8 text-gray-900">{copy.faq}</h2>
        <div class="max-w-3xl mx-auto space-y-4">{game.faq.map((item: { question: string; answer: string }) => (<details class="group bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden"><summary class="flex items-center justify-between p-6 cursor-pointer font-semibold text-gray-900 hover:bg-gray-50">{item.question}</summary><div class="px-6 pb-6 text-gray-600">{item.answer}</div></details>))}</div>
      </section>

      {activeGuidesZh.length > 0 && (
        <section class="mb-16 bg-primary-50 rounded-2xl p-8"><h2 class="text-2xl font-bold mb-6 text-gray-900">{copy.guides}</h2><div class="space-y-4">{activeGuidesZh.map((guide: { title: string; url: string }) => (<a href={guide.url} class="block p-4 bg-white rounded-lg border border-primary-100 hover:border-primary-300"><span class="font-medium text-gray-900">{guide.title}</span></a>))}</div></section>
      )}

      <section class="mb-16">
        <h2 class="text-2xl font-bold text-center mb-6 text-gray-900">{copy.other}</h2>
        <div class="grid grid-cols-2 md:grid-cols-6 gap-4">
          {game.slug === 'rpg-maker' && (
            <a href="/zh-cn/games/crimson-moon-immortal/" class="p-4 bg-white rounded-xl border border-gray-100 hover:border-primary-300 hover:shadow-md text-center">
              <span class="text-2xl block mb-2">🌙</span>
              <span class="font-medium text-gray-900 text-sm">绯月仙行录存档修改</span>
            </a>
          )}
          {baseGames.filter((item) => item.slug !== game.slug).slice(0, 6).map((item) => (<a href={gameHref(item.slug)} class="p-4 bg-white rounded-xl border border-gray-100 hover:border-primary-300 hover:shadow-md text-center"><span class="text-2xl block mb-2">{item.emoji}</span><span class="font-medium text-gray-900 text-sm">{localizedNames[item.slug] ?? item.name}</span></a>))}
        </div>
        <div class="text-center mt-6"><a href={gamesHref} class="text-primary-600 hover:text-primary-700 font-medium">{copy.browse}</a></div>
      </section>

      <section class="bg-gray-900 text-white rounded-2xl p-12 text-center">
        <h2 class="text-3xl font-bold mb-4">{copy.ready}</h2>
        <p class="text-gray-300 mb-8 max-w-xl mx-auto">{copy.ctaBody}</p>
        <a href={editorHrefWithGame} class="inline-flex items-center justify-center px-8 py-4 text-lg font-semibold text-gray-900 bg-white rounded-xl hover:bg-gray-100">{copy.now}</a>
      </section>

      {game.seoContent && (
        <section class="max-w-4xl mx-auto mt-16 prose prose-lg prose-slate px-6 py-8 bg-white rounded-2xl shadow-sm border border-gray-100">
          <Fragment set:html={game.seoContent} />
        </section>
      )}
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: '首页', item: absUrl('/zh-cn') }, { '@type': 'ListItem', position: 2, name: '游戏', item: absUrl('/zh-cn/games') }, { '@type': 'ListItem', position: 3, name: game.nameLocal, item: absUrl(`/zh-cn/games/${game.slug}`) }] })} />
  <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: game.faq.map((item: { question: string; answer: string }) => ({ '@type': 'Question', name: item.question, acceptedAnswer: { '@type': 'Answer', text: item.answer } })) })} />
  <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@type': 'SoftwareApplication', name: `${game.nameLocal} 存档编辑器`, applicationCategory: 'UtilitiesApplication', operatingSystem: 'Web Browser', inLanguage: 'zh-CN', url: absUrl(`/zh-cn/games/${game.slug}`), image: imageUrl, isAccessibleForFree: true, featureList, offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' }, description: game.seoDescriptionByLocale[locale], author: { '@type': 'Organization', name: 'SaveEditor.Online', url: absUrl('/') } })} />
</BaseLayout>
