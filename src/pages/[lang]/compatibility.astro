---
import { getEntryBySlug } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export function getStaticPaths() {
  return [
    { params: { lang: 'ja' } },
    { params: { lang: 'pt' } },
    { params: { lang: 'ko' } },
    { params: { lang: 'zh-cn' } },
    { params: { lang: 'ru' } },
    { params: { lang: 'es' } },
  ];
}

const { lang } = Astro.params;
const entry = await getEntryBySlug('compatibility', 'matrix');
if (!entry) {
  throw new Error('Compatibility matrix content is missing: src/content/compatibility/matrix.md');
}
const { Content } = await entry.render();
---

<BaseLayout
  title={`Compatibility Matrix | Save Editor Online`}
  description="Live compatibility matrix for supported engines/formats, edit/save safety level, and known limitations."
>
  <main class="container mx-auto px-4 py-10">
    <div class="max-w-5xl mx-auto">
      <div class="mb-8">
        <h1 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-3">Compatibility Matrix</h1>
        <p class="text-gray-600">
          Locale: <span class="font-mono uppercase">{lang}</span>. Matrix content is shared across locales to keep support status consistent.
        </p>
      </div>

      <article class="prose prose-gray max-w-none bg-white border border-gray-100 rounded-2xl p-6 sm:p-8 shadow-sm">
        <Content />
      </article>
    </div>
  </main>
</BaseLayout>
