---
import EditorPageTemplate from '../../../components/templates/EditorPageTemplate.astro';
import { editors } from '../../../data/editors';

export async function getStaticPaths() {
  return editors.map((engine) => ({
    params: { slug: engine.slug },
    props: { engine },
  }));
}

const { engine } = Astro.props;
---

<EditorPageTemplate engine={engine} lang="ja" />
