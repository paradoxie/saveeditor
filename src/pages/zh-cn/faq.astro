---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FaqIcon from '../../components/FaqIcon.astro';
import { localizePath } from '../../i18n/utils';

const faqCategories = [
  {
    title: '入门指南',
    icon: 'rocket',
    questions: [
      {
        question: 'SaveEditor.Online 是什么？',
        answer:
          "SaveEditor.Online 是一个免费的、基于浏览器的兼容游戏存档编辑工具。它会在浏览器内解析您选择的存档文件。我们支持多种流行的游戏引擎，例如 RPG Maker、Unity、Ren'Py、Unreal Engine 等等。对于 Unreal 的 `.sav` 格式，我们采用兼容性优先策略：标准的未加密 GVAS 格式支持度最好，而针对游戏特定容器或压缩的变体版本则可能只支持读取。",
      },
      {
        question: '这个工具安全吗？',
        answer:
          'SaveEditor.Online 的主编辑流程会在浏览器内解析兼容存档文件。可选的本地编辑历史默认关闭；开启后，最近备份只保存在您的浏览器 IndexedDB 中，并可随时清空。保存的编辑模板也只保存在浏览器 IndexedDB 中。我们使用 Google Analytics、一方事件日志和 AdSense 来了解网站性能和展示广告；具体详情请查看我们的隐私政策和 Cookie 政策。',
      },
      {
        question: '需要创建账户吗？',
        answer:
          '不需要。SaveEditor.Online 不需要注册、登录，也不收集个人信息。只需上传您的存档文件即可立即开始编辑。',
      },
      {
        question: '这真的免费吗？',
        answer:
          '是的，编辑器可免费使用。我们通过自愿捐赠和非侵入式的广告来维持运营。',
      },
    ],
  },
  {
    title: '支持的游戏和格式',
    icon: 'game',
    questions: [
      {
        question: '我可以编辑哪些游戏？',
        answer:
          "我们支持横跨多个引擎的数千款游戏。热门且支持良好的游戏包括《星露谷物语》(Stardew Valley)、《传说之下》(Undertale)、《空洞骑士》(Hollow Knight)、《心跳文学部》(Doki Doki Literature Club)、《蔚蓝》(Celeste)、《Omori》、《OneShot》、《去月球》(To The Moon)，以及几乎所有使用 RPG Maker、Ren'Py、Unity 或 GameMaker 制作的游戏。",
      },
      {
        question: '支持哪些文件格式？',
        answer:
          "我们支持：RPG Maker MV/MZ (.rpgsave, .rmmzsave)、Ren'Py (.save, persistent)、Unity (PlayerPrefs 的 .xml/.plist, 或 JSON)、Unreal Engine (.sav；优先处理标准未加密的 GVAS，容器化/压缩后的变种格式可能只读)、GameMaker (.ini, .json)、NaniNovel (.nson)，以及一些通用的 JSON/XML 格式文件。",
      },
      {
        question: '我可以编辑主机游戏（PlayStation, Xbox, Switch）的存档吗？',
        answer:
          '很抱歉，主机游戏的存档通常使用各平台特定的 DRM 加密保护，因此无法直接编辑。我们的编辑器仅适用于 PC/Mac/Linux 平台的存档文件。不过某些类似《星露谷物语》这样支持跨平台存档 (Cross-save) 的游戏，您可以通过 PC 端中转来间接实现。',
      },
      {
        question: "我的游戏没在列表中，还能使用编辑器吗？",
        answer:
          "也许可以！如果您的游戏使用了标准的 JSON、XML 或 INI 格式，我们的通用型解析器就有可能处理它。您不妨尝试上传存档文件，看看是否能被解析。如果不行，您可以联系我们，我们可能会在未来加入对该游戏格式的支持。",
      },
    ],
  },
  {
    title: '查找存档文件',
    icon: 'folder',
    questions: [
      {
        question: '在 Windows 上存档文件位于哪里？',
        answer:
          "常见的位置包括：%AppData%（按下 Win+R 键，输入 %appdata% 然后回车）、%LocalAppData%、Documents/My Games 文件夹，或者是游戏的安装目录。对于 Steam 游戏，还可以检查 Steam/userdata/[您的ID]/[游戏ID]/ 目录。",
      },
      {
        question: '在 Mac 上存档文件位于哪里？',
        answer:
          "对于大多数游戏，请检查 ~/Library/Application Support/ 目录。对于 Unity 开发的游戏，请寻找 ~/Library/Application Support/unity.[开发商名].[游戏名]。对于 Ren'Py 游戏，请检查 ~/Library/RenPy/[游戏名称]。",
      },
      {
        question: '在 Linux 上存档文件位于哪里？',
        answer:
          '大部分原生 Linux 游戏会将存档保存在 ~/.config/[游戏名称] 或 ~/.local/share/[游戏名称] 目录下。对于通过 Proton 兼容层运行的 Steam 游戏，请检查 ~/.steam/steam/steamapps/compatdata/[游戏ID]/pfx/ 目录。',
      },
      {
        question: "我如何准确找到某一款特定游戏的存档位置？",
        answer:
          "您可以访问我们为您准备的特定游戏页面（例如 /zh-cn/games/stardew-valley）以获取确切路径。或者在搜索引擎上搜索“[游戏名称] save file location / 存档位置”，或者在游戏的设置与选项菜单里找找看。",
      },
    ],
  },
  {
    title: '编辑存档',
    icon: 'pencil',
    questions: [
      {
        question: '我如何修改金币/金钱/货币？',
        answer:
          "上传您的存档文件后，请搜索诸如 'gold', 'money', 'currency', 'coins', 或者 'funds' 这样的关键词字段。并将对应的值修改为您想要的数额。对于 RPG Maker 游戏，您可以在队伍 (party) 的数据中寻找 '_gold' 字段。请记得保持所填数值的合理性，以避免在游戏中引发 bug。",
      },
      {
        question: '我如何在物品栏中添加物品？',
        answer:
          "在您的存档中找到 inventory（物品栏）或 items 数组。如果是 RPG Maker，物品一般以 [物品ID, 数量] 成对的形式存储。如果是 Unity 游戏，请查找 'inventory' 或 'items' 对象。请严格参照存档已有的格式结构来添加新的内容条目。",
      },
      {
        question: "我可以修改角色的属性（HP、等级等）吗？",
        answer:
          "可以！请查找像 'hp', 'maxHp', 'level', 'exp', 'str', 'def' 等字段。对于 RPG Maker 游戏，这些常存在于 actors（角色）数组中。对于 Unity 游戏，您可以检查 player data（玩家数据）对象。",
      },
      {
        question: '如何解锁成就或剧情进度？',
        answer:
          "成就通常是以布尔值标志 (boolean flags) 或时间戳对象的形式保存的。请尝试搜索 'achievement', 'unlock', 'flag', 或是 'completed'。剧情故事的进度通常使用开关数组（在 RPG Maker 中比较常见）直接记录，或者使用进度对象来控制。",
      },
      {
        question: '编辑存档会损坏我的游戏或存档文件吗？',
        answer:
          '我们的编辑器会对修改的内容进行验证以避免那些明显的错误，但是极端或大幅度的修改依然有可能引起问题。请务必在修改前做好备份！经常出现的问题包括：数值改得过大导致溢出报错，填写了无效的物品 ID，或者不小心删除了某个必要的字段。',
      },
    ],
  },
  {
    title: 'Steam & 云存档',
    icon: 'cloud',
    questions: [
      {
        question: 'Steam 云存档一直覆盖还原我刚改好的存档！',
        answer:
          "您需要在这个游戏上禁用 Steam 云同步：右键单击游戏 → 属性 → 通用 → 取消勾选“将游戏存档保存于 Steam 云”。完成编辑后，先进入游戏验证修改是否成功，随后的任何时候如果您有需要，可以再重新启用云同步功能。",
      },
      {
        question: '编辑存档会导致我收到 VAC 封禁吗？',
        answer:
          '对于本地单机存档，VAC 通常不会介入。不要在公共服务器、竞技模式或明确禁止修改的在线游戏中使用改过的存档。',
      },
      {
        question: '修改存档后，我的 Steam 成就还能正常解锁吗？',
        answer:
          "对于单机游戏来说，可以的。Steam 是检测不到你本地存档的内部数据修改过程的。因此，你的成就只受限于游戏自身的内部检测逻辑而会照常解锁。",
      },
    ],
  },
  {
    title: '疑难解答与故障排除',
    icon: 'wrench',
    questions: [
      {
        question: "为什么编辑器提示 'Invalid file'（无效文件）或 'Parse error'（解析错误）？",
        answer:
          '这意味着该游戏可能使用了我们当前不支持的特殊格式、专属加密或压缩。您可以尝试：1) 在编辑器界面手动选择一个不同的解析类型再试，2) 检查您上传的文件究竟是不是该存档的本体（不要传备份档或是临时文件），3) 该游戏非常可能使用了私有的格式编码。',
      },
      {
        question: "修改后把文件放回去，但是游戏无法读取了！",
        answer:
          '常见解决手段：1) 请确认您准确无误地替换了原路径的正确文件，2) 检查是否被 Steam 云同步又覆盖还原了，3) 有些游戏内置有校验和检测 (checksum validation) —— 您可以尝试缩小修改的数值幅度再试，4) 将您一开始留存的备份文件还原，重头再来一次。',
      },
      {
        question: '我刚刚把数值编辑好了，但在我重新加载游戏的时候又全都被重置了！',
        answer:
          '有些游戏会在每次加载时动态重新计算部分数值。比如那些衍生属性（即根据当前等级计算得出的最大生命值等）这类的数值就必定会被重新计算。与其直接修改最大生命值，建议您去直接修改那些决定这些属性的“基础值”。',
      },
      {
        question: '修改可以撤销操作吗？',
        answer:
          "一旦您将文件下载到本地，这些修改就被固化了。对于存档，请保持随时备份的好习惯！如果您没有留下备份，您可以尝试：1) 去检查 Steam 云同步中是否还有未被污染的原始版本，2) 去检查游戏文件夹里有没有自动生成的 .bak 备份文件，3) 您是否有开启电脑系统的还原点功能。",
      },
    ],
  },
];

// Flatten all questions for schema
const allQuestions = faqCategories.flatMap((cat) => cat.questions);
---

<BaseLayout
  title="常见问题 (FAQ) - 关于存档编辑的常见问题"
  description="获取有关 SaveEditor.Online 的常见问题与解答。了解如何查找存放路径、编辑游戏本地数据、如何解决遇到的困难以及更多功能。"
  keywords="存档编辑器 FAQ, 如何编辑游戏存档, 存档存放位置, 存档修改帮助, rpg maker 存档编辑器疑难解答"
>
  <!-- Hero Section -->
  <section class="bg-gradient-to-br from-slate-900 via-primary-900 to-slate-900 text-white py-16">
    <div class="container mx-auto px-4 text-center">
      <h1 class="text-4xl sm:text-5xl font-bold tracking-tight mb-4">
        常见<span
          class="text-transparent bg-clip-text bg-gradient-to-r from-primary-400 to-cyan-400"
          >问题</span
        >
      </h1>
      <p class="text-xl text-gray-300 max-w-2xl mx-auto">
        关于使用 SaveEditor.Online 编辑游戏存档您需要了解的一切
      </p>
    </div>
  </section>

  <section class="container mx-auto px-4 py-16">
    <div class="max-w-4xl mx-auto">
      <!-- Quick Navigation -->
      <nav class="mb-12 p-6 bg-gray-50 rounded-2xl">
        <h2 class="text-lg font-bold text-gray-900 mb-4">跳转到章节</h2>
        <div class="flex flex-wrap gap-3">
          {
            faqCategories.map((category, index) => (
              <a
                href={`#section-${index}`}
                class="inline-flex items-center gap-2 px-4 py-2 bg-white rounded-full border border-gray-200 hover:border-primary-300 hover:bg-primary-50 transition-colors text-sm font-medium"
              >
                <FaqIcon name={category.icon} class="w-4 h-4 text-primary-500" />
                <span>{category.title}</span>
              </a>
            ))
          }
        </div>
      </nav>

      <!-- FAQ Categories -->
      {
        faqCategories.map((category, catIndex) => (
          <section id={`section-${catIndex}`} class="mb-12">
            <h2 class="flex items-center gap-3 text-2xl font-bold text-gray-900 mb-6">
              <FaqIcon name={category.icon} class="w-8 h-8 text-primary-500" />
              {category.title}
            </h2>
            <div class="space-y-4">
              {category.questions.map((faq) => (
                <details class="group bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
                  <summary class="flex items-center justify-between p-6 cursor-pointer font-semibold text-gray-900 hover:bg-gray-50">
                    {faq.question}
                    <svg
                      class="w-5 h-5 text-gray-500 group-open:rotate-180 transition-transform flex-shrink-0 ml-4"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M19 9l-7 7-7-7"
                      />
                    </svg>
                  </summary>
                  <div class="px-6 pb-6 text-gray-600 leading-relaxed">{faq.answer}</div>
                </details>
              ))}
            </div>
          </section>
        ))
      }

      <!-- Still Have Questions CTA -->
      <section class="bg-gray-900 text-white rounded-2xl p-8 text-center mt-12">
        <h2 class="text-2xl font-bold mb-4">还有其他问题没有解决吗？</h2>
        <p class="text-gray-300 mb-6">
          如果没有找到您想要寻找的答案？欢迎查看我们特制的特定游戏指南页面，或是直接联系我们解决。
        </p>
        <div class="flex flex-wrap justify-center gap-4">
          <a
            href={localizePath('/games', 'zh-cn')}
            class="inline-flex items-center justify-center px-6 py-3 bg-white text-gray-900 rounded-xl font-semibold hover:bg-gray-100 transition-colors"
          >
            浏览游戏支持列表
          </a>
          <a
            href={localizePath('/contact', 'zh-cn')}
            class="inline-flex items-center justify-center px-6 py-3 border border-white/30 text-white rounded-xl font-semibold hover:bg-white/10 transition-colors"
          >
            联系我们
          </a>
        </div>
      </section>
    </div>
  </section>

  <!-- FAQ Schema -->
  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: allQuestions.map((faq) => ({
        '@type': 'Question',
        name: faq.question,
        acceptedAnswer: {
          '@type': 'Answer',
          text: faq.answer,
        },
      })),
    })}
  />

  <!-- BreadcrumbList Schema -->
  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://saveeditor.top/zh-cn/' },
        { '@type': 'ListItem', position: 2, name: 'FAQ', item: 'https://saveeditor.top/zh-cn/faq/' },
      ],
    })}
  />
</BaseLayout>
