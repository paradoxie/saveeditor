---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EditorApp from '../../components/EditorApp';
import { localizePath, useTranslations, type SiteLang } from '../../i18n/utils';

interface EngineData {
  slug: string;
  name: string;
  fileType: string;
  title: string;
  description: string;
  keywords: string;
  features: string[];
  instructions: string[];
}

interface Props {
  engine: EngineData;
  lang?: SiteLang;
}

const { engine, lang = 'en' } = Astro.props;
const t = useTranslations(lang);
const siteOrigin = Astro.site ? new URL(Astro.site).origin : 'https://saveeditor.top';
const absUrl = (path: string) =>
  new URL(path.endsWith('/') ? path : `${path}/`, siteOrigin).toString();

const STRINGS: Record<
  SiteLang,
  {
    uploadPrompt: string;
    howToUse: string;
    features: string;
    needHelp: string;
    needHelpBody: string;
    readTutorial: string;
  }
> = {
  en: {
    uploadPrompt: 'Upload your',
    howToUse: 'How to use',
    features: 'Features',
    needHelp: 'Need Help?',
    needHelpBody: 'Check out our detailed guide for',
    readTutorial: 'Read Complete Tutorial',
  },
  ja: {
    uploadPrompt: '次のファイルをアップロードして編集を開始',
    howToUse: '使い方',
    features: '主な機能',
    needHelp: 'ヘルプ',
    needHelpBody: '次のガイドもご覧ください',
    readTutorial: '完全ガイドを読む',
  },
  pt: {
    uploadPrompt: 'Envie seu arquivo',
    howToUse: 'Como usar',
    features: 'Recursos',
    needHelp: 'Precisa de ajuda?',
    needHelpBody: 'Confira o guia detalhado de',
    readTutorial: 'Ler tutorial completo',
  },
  ko: {
    uploadPrompt: '다음 파일을 업로드해 편집을 시작하세요',
    howToUse: '사용 방법',
    features: '기능',
    needHelp: '도움이 필요하신가요?',
    needHelpBody: '다음 상세 가이드를 확인하세요',
    readTutorial: '전체 가이드 보기',
  },
  'zh-cn': {
    uploadPrompt: '上传你的',
    howToUse: '使用方法',
    features: '功能',
    needHelp: '需要帮助？',
    needHelpBody: '查看以下详细指南',
    readTutorial: '阅读完整教程',
  },
  es: {
    uploadPrompt: 'Sube tu archivo',
    howToUse: 'Cómo usarlo',
    features: 'Funciones',
    needHelp: '¿Necesitas ayuda?',
    needHelpBody: 'Consulta la guía detallada de',
    readTutorial: 'Leer guía completa',
  },
  ru: {
    uploadPrompt: 'Загрузите файл',
    howToUse: 'Как использовать',
    features: 'Возможности',
    needHelp: 'Нужна помощь?',
    needHelpBody: 'Откройте подробное руководство по',
    readTutorial: 'Читать полное руководство',
  },
};

const strings = STRINGS[lang];
const homeHref = localizePath('/', lang);

const tutorialMap = {
  'rpg-maker-mv': localizePath('/blog/how-to-edit-rpg-maker-save', lang),
  unity: localizePath('/blog/how-to-edit-unity-saves', lang),
  unreal: localizePath('/blog/how-to-edit-unreal-engine-saves', lang),
  palworld: localizePath('/blog/palworld-save-editing-guide', lang),
  renpy: localizePath('/blog/renpy-save-editing-guide', lang),
  naninovel: localizePath('/blog/naninovel-save-editing-guide', lang),
  gamemaker: localizePath('/blog/gamemaker-save-editing-guide', lang),
} as const;

const tutorialLink =
  tutorialMap[engine.slug as keyof typeof tutorialMap] ||
  localizePath('/blog/common-save-file-extensions-explained', lang);
---

<BaseLayout title={engine.title} description={engine.description} keywords={engine.keywords}>
  <section class="container mx-auto px-4 py-8">
    <div class="max-w-6xl mx-auto">
      <nav class="flex text-sm text-gray-500 mb-8" aria-label="Breadcrumb">
        <ol class="inline-flex items-center space-x-1 md:space-x-3">
          <li class="inline-flex items-center">
            <a href={homeHref} class="hover:text-gray-900">{t('nav.home')}</a>
          </li>
          <li>
            <div class="flex items-center">
              <svg
                class="w-3 h-3 text-gray-400 mx-1"
                aria-hidden="true"
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 6 10"
              >
                <path
                  stroke="currentColor"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="m1 9 4-4-4-4"></path>
              </svg>
              <span class="ml-1 text-gray-700 font-medium">{engine.name}</span>
            </div>
          </li>
        </ol>
      </nav>

      <div class="text-center mb-10">
        <h1 class="text-3xl font-bold text-gray-900 sm:text-4xl mb-4">
          {engine.name} Save Editor
        </h1>
        <p class="text-lg text-gray-600">
          {strings.uploadPrompt}
          <code class="bg-gray-100 px-2 py-1 rounded text-sm">{engine.fileType}</code>
        </p>
      </div>

      <!-- Interactive Editor App -->
      <div class="min-h-[400px]">
        <EditorApp
          client:only="react"
          acceptedFileTypes={engine.fileType}
          editorSlug={engine.slug}
        />
      </div>

      <div class="mt-16 prose prose-blue max-w-none">
        <h2>{strings.howToUse}</h2>
        <ol>
          {
            engine.instructions.map((step) => (
              <li>
                <Fragment set:html={step.replace(/`([^`]+)`/g, '<code>$1</code>')} />
              </li>
            ))
          }
        </ol>

        <h2>{strings.features}</h2>
        <ul>
          {engine.features.map((feature) => <li>{feature}</li>)}
        </ul>
      </div>

      <div class="bg-blue-50 border border-blue-100 rounded-xl p-6 mt-12 not-prose">
        <h3 class="text-lg font-bold text-blue-900 mb-2">{strings.needHelp}</h3>
        <p class="text-blue-700 mb-4">
          {strings.needHelpBody} {engine.name}.
        </p>
        <a
          href={tutorialLink}
          class="text-blue-600 font-medium hover:underline flex items-center gap-1"
        >
          {strings.readTutorial}
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M17 8l4 4m0 0l-4 4m4-4H3"
            />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'SoftwareApplication',
      name: `${engine.name} Save Editor`,
      description: engine.description,
      applicationCategory: 'GameApplication',
      operatingSystem: 'Web Browser',
      offers: {
        '@type': 'Offer',
        price: '0',
        priceCurrency: 'USD',
      },
      featureList: engine.features,
      url: absUrl(localizePath(`/editor/${engine.slug}`, lang)),
      author: {
        '@type': 'Organization',
        name: 'SaveEditor.Online',
        url: absUrl('/'),
      },
    })}
  />

  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: t('nav.home'),
          item: absUrl(homeHref),
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: `${engine.name} Editor`,
          item: absUrl(localizePath(`/editor/${engine.slug}`, lang)),
        },
      ],
    })}
  />
</BaseLayout>
